---
import { existsSync } from 'node:fs';
import RingExperience from '../components/RingExperience.astro';
import '../styles/global.css';

const site = Astro.site ?? new URL('https://yevhen-chumak.vercel.app');
const canonical = new URL('/', site).href;
const title = 'Yevhen Chumak — Frontend Developer';
const description =
  'Frontend developer with 4 years of commercial experience and 50+ projects: large corporate websites with Astro, Next.js, React, TypeScript and Webflow, CMS architecture, GSAP animations, API integrations and performance optimization.';
// The OG image is added later: drop it into public/og-image.png (1200 x 630) and the tags appear on the next build.
const ogImage = existsSync('public/og-image.png') ? new URL('/og-image.png', site).href : null;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yevhen Chumak',
  url: canonical,
  jobTitle: 'Frontend Developer',
  knowsAbout: ['JavaScript', 'TypeScript', 'React', 'Next.js', 'Astro', 'Webflow', 'GSAP', 'CMS Architecture', 'Technical SEO', 'Performance Optimization'],
  sameAs: ['https://www.linkedin.com/in/yevhen-chumak-605516274/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yevhen Chumak" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#c4d8ec" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yevhen Chumak" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/hero-sky.webp" fetchpriority="high" />
  </head>
  <body>
    <main>
      <RingExperience />
    </main>
  </body>
</html>
