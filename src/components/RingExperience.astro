---
import { cases } from '../data/cases';

const sectionWidth = 1280;
const sectionHeight = 720;

// Ice palette by screen position (more screens than colors simply cycle through it)
const iceColors = ['#f3fbff', '#d6ecff', '#9dcdf4', '#5d99c6', '#d9f7ff', '#eef0ff', '#bddcf6', '#e6f3ff'];

const hero = {
  title: 'Hello, I`m Yevhen',
  text: 'I’m a developer with 4 years of commercial experience and more than 50 completed projects, building large, complex websites with Webflow, Astro, Next.js and React, plus API integrations, GSAP animations and performance optimization.',
};

// Contact screen: copy and links come from the old portfolio's Contact section
const contact = {
  lead: ['Let’s work', 'together.'],
  intro: ['Have a project, collaboration,', 'or opportunity in mind?'],
  outro: 'Feel free to get in touch.',
  links: [
    { label: 'Email', value: 'gekachumak@gmail.com', href: 'mailto:gekachumak@gmail.com', external: false },
    { label: 'WhatsApp', value: '+380 68 230 61 43', href: 'https://wa.me/380682306143', external: true },
    { label: 'LinkedIn', value: 'Yevhen Chumak', href: 'https://www.linkedin.com/in/yevhen-chumak-605516274/', external: true },
    { label: 'Telegram', value: '@yevhen_chumak', href: 'https://t.me/yevhen_chumak', external: true },
  ],
  year: new Date().getFullYear(),
};

// Skills & more works screen: skill groups from the old portfolio's Services section, then a few more projects with a
// screenshot and a "see all" list of the rest (the projects that already have a case are left out)
const skills = {
  groups: [
    { title: 'Frontend Development', items: ['HTML/CSS', 'JavaScript / TypeScript', 'React', 'Next.js', 'Astro', 'Node.js', 'GSAP', 'API Integrations', 'Three.js / Spline'] },
    { title: 'Webflow Development', items: ['Webflow', 'Finsweet', 'Client-First', 'CMS Architecture', 'Technical SEO', 'Performance Optimization', 'Tryformly', 'Zapier / Make / n8n'] },
    { title: 'Design & Tools', items: ['Figma', 'GitHub', 'Sanity'] },
    { title: 'Team & Workflow', items: ['ClickUp', 'Asana', 'Daily Team Calls', 'Client Communication', 'Mentoring'] },
  ],
  featured: [
    { name: 'Fuhrmann', url: 'https://fuhrmann-website-before-client-tran.vercel.app/', image: '/projects/fuhrmann.webp' },
    { name: 'Rohlmann', url: 'https://www.rohlmann-steuer.de/', image: '/projects/rohlmann.webp' },
    { name: 'ByteSnipers', url: 'https://www.bytesnipers.com/', image: '/projects/bytesnipers.webp' },
    { name: 'esport Stores', url: 'https://www.esport-stores.com/', image: '/projects/esport-stores.webp' },
  ],
  more: [
    ['aquadona', 'Aquadona', 'https://www.aquadona.com/trinkwasserbrunnen-bach'],
    ['chiropraxis-gaertner', 'Chiropraxis Gärtner', 'https://www.chiropraxis-gaertner.de/'],
    ['coldbase', 'Coldbase', 'https://www.coldbase.de/'],
    ['cycura', 'Cycura', 'https://www.cycura.de/en'],
    ['erkiert-mainka', 'Erkiert & Mainka', 'https://www.erkiertmainka.com/'],
    ['ertan-kollegen', 'Ertan & Kollegen', 'https://ertan-kollegen.webflow.io/'],
    ['gravity', 'Gravity Livemusic', 'https://www.gravity-livemusic.com/'],
    ['gruender-starthilfe', 'Gründer Starthilfe', 'https://www.gruender-starthilfe.de/'],
    ['karma-service', 'Karma Service', 'https://www.karma-service.de/'],
    ['markus-mensch', 'Markus Mensch', 'https://www.markus-mensch.de/'],
    ['medienhafen', 'MedienHafen', 'https://www.medienhafen-dus.de/'],
    ['modulacht', 'Modulacht', 'https://www.modulacht.de/'],
    ['tp-lift', 'TP Lift', 'https://www.tp-lift.com/'],
    ['wavenine', 'Wave Nine', 'https://wavenine.com/'],
    ['5-tage-challenge', '5 Tage Challenge', 'https://www.5tagechallenge.de/'],
    ['braeuning', 'Bräuning', 'https://www.braeuning-unternehmensberatung.de/'],
    ['flexxter', 'Flexxter', 'https://www.flexxter.com/'],
    ['istok', 'Istok', 'https://k129---istok-one.webflow.io/'],
  ].map(([id, name, url]) => ({ name, url, image: `/projects/${id}.webp` })),
};

// Screens: the hero, the case studies, skills, a closing contact screen. The route zigzags right, down, right, down...
// The next lap starts one step after the last screen: ceil(n/2) columns and floor(n/2) rows further on (with an odd
// number of screens the seam simply has two moves in the same direction).
const total = cases.length + 3;
const grid = Array.from({ length: total }, (_, index) => [Math.ceil(index / 2), Math.floor(index / 2)]);
const lapX = Math.ceil(total / 2);
const lapY = Math.floor(total / 2);
const cycleX = sectionWidth * lapX;
const cycleY = sectionHeight * lapY;
const place = (index: number) => ({ color: iceColors[index % iceColors.length], x: grid[index][0] * sectionWidth, y: grid[index][1] * sectionHeight });

const sections = [
  { kind: 'hero' as const, ...hero, ...place(0) },
  ...cases.map((project, index) => ({ kind: 'case' as const, ...project, ...place(index + 1) })),
  { kind: 'skills' as const, ...skills, ...place(total - 2) },
  { kind: 'contact' as const, ...contact, ...place(total - 1) },
];

// Detail sections: every block becomes a short row (title, up to two paragraphs, a few chips); rows are grouped
// into screens by length so each screen fits without scrolling.
type Block = (typeof cases)[number]['blocks'][number];
type Row = { title: string; texts: string[]; chips: string[] };

const clip = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('; '));
  return end > 80 ? cut.slice(0, end + 1) : `${cut.slice(0, cut.lastIndexOf(' '))}…`;
};

const toRow = (block: Block): Row => {
  const paragraphs = block.paragraphs?.length ? block.paragraphs : block.lists?.[0] ? [block.lists[0].intro] : [];
  return {
    title: block.title,
    texts: [clip(paragraphs[0] ?? '', 340), ...(paragraphs[1] ? [clip(paragraphs[1], 200)] : [])].filter(Boolean),
    chips: [...(block.items ?? []), ...(block.lists ?? []).flatMap((list) => list.items)].slice(0, 10),
  };
};

const weigh = (row: Row) => 150 + row.texts.reduce((sum, text) => sum + text.length, 0) + row.chips.reduce((sum, chip) => sum + chip.length + 8, 0) * .6;

const chunkRows = (blocks: Block[]) => {
  const groups: Row[][] = [[]];
  let weight = 0;
  let limit = 520;
  for (const row of blocks.map(toRow)) {
    const next = weigh(row);
    if (weight + next > limit && groups[groups.length - 1].length) {
      groups.push([]);
      weight = 0;
      limit = 900;
    }
    groups[groups.length - 1].push(row);
    weight += next;
  }
  return groups;
};

type DetailPart = { kind: 'rows'; rows: Row[] } | { kind: 'diagram' };
const detailParts = (project: (typeof cases)[number]): DetailPart[] => {
  const parts: DetailPart[] = chunkRows(project.blocks).map((rows) => ({ kind: 'rows', rows }));
  if (project.diagram) parts.splice(1, 0, { kind: 'diagram' });
  return parts;
};

// "See all projects" opens the rest like a case's detail sections: six projects per section
const worksPerPage = 6;
const worksPages = Array.from({ length: Math.ceil(skills.more.length / worksPerPage) }, (_, page) =>
  skills.more.slice(page * worksPerPage, (page + 1) * worksPerPage));

// The scene keeps four copies of the lap (the one before, the current one and two after). Only slot 0 is in the HTML;
// the script clones the other three, which keeps the page about four times lighter.
const groupSlots = [0];
---

<div
  class="experience is-loading"
  data-experience
  data-count={sections.length}
  data-cycle-x={cycleX}
  data-cycle-y={cycleY}
  data-grid={JSON.stringify(grid)}
  data-lap-x={lapX}
  data-lap-y={lapY}
  data-colors={JSON.stringify(iceColors)}
  tabindex="0"
>
  <div class="viewport">
    <div class="camera" data-camera>
      {groupSlots.map((slot) => (
        <div class="cycle" data-cycle data-slot={slot}>
          {sections.map((section, index) => (
            <section
              class={section.kind === 'contact' || section.kind === 'skills' ? `screen screen--${section.kind}` : 'screen'}
              data-screen={index}
              data-case={section.kind === 'case' ? section.id : section.kind === 'skills' ? 'more-works' : undefined}
              style={`left:${section.x}px;top:${section.y}px;--color:${section.color}`}
            >
              {section.kind === 'hero' ? (
                <>
                  <canvas class="sky" data-sky aria-hidden="true"></canvas>
                  <h1 class="hero__title">{section.title}</h1>
                  <div class="hero__box">
                    <p class="hero__text">{section.text}</p>
                    <div class="hero__actions">
                      <button class="hero__button hero__button--light" type="button" data-go-works>Go to works</button>
                      <button class="hero__button hero__button--dark" type="button" data-go-contact>Contact me</button>
                    </div>
                  </div>
                </>
              ) : section.kind === 'skills' ? (
                <>
                  <div class="skills__grid">
                    {section.groups.map((group) => (
                      <article class="skills__card">
                        <h2 class="skills__heading">{group.title}</h2>
                        <ul class="skills__list">
                          {group.items.map((item) => (
                            <li>
                              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.2 8.4l3.1 3.1 6.5-7" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                              {item}
                            </li>
                          ))}
                        </ul>
                      </article>
                    ))}
                  </div>
                  <div class="works">
                    <h2 class="works__label">More works</h2>
                    <div class="works__grid">
                      {section.featured.map((work) => (
                        <a class="works__card" href={work.url} target="_blank" rel="noreferrer">
                          <span class="works__shot"><img src={work.image} alt={`${work.name} website`} width="1530" height="900" loading="lazy" decoding="async" /></span>
                          <span class="works__name">{work.name}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
                        </a>
                      ))}
                    </div>
                    <button class="works__all" type="button" data-case-more>See all projects</button>
                  </div>
                </>
              ) : section.kind === 'contact' ? (
                <>
                  <canvas class="sky sky--contact" data-sky-contact aria-hidden="true"></canvas>
                  <header class="contact__top">
                    <h2 class="contact__eyebrow">Contact</h2>
                  </header>
                  <p class="contact__title" aria-label={section.lead.join(' ')}>
                    {section.lead.map((line) => <span aria-hidden="true">{line.split(' ').map((word) => <b>{word}</b>)}</span>)}
                  </p>
                  <div class="contact__side">
                    <p class="contact__intro">{section.intro.map((line) => <span>{line}</span>)}<em>{section.outro}</em></p>
                    <div class="contact__links">
                      {section.links.map((link) => (
                        <a class="contact__link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
                          <span class="contact__label">{link.label}</span>
                          <span class="contact__value">{link.value}</span>
                          <span class="contact__arrow"><svg viewBox="0 0 16 15" fill="none" aria-hidden="true"><path d="M0 6.92309H13.8418L9.096 2.0772L10.1243 1.5L16 7.5L10.1243 13.5L9.096 12.9228L13.8418 8.07693H0Z" fill="currentColor"></path></svg></span>
                        </a>
                      ))}
                    </div>
                  </div>
                  <footer class="contact__foot">
                    <p>© {section.year} Yevhen Chumak</p>
                  </footer>
                </>
              ) : (
                <>
                  <h2 class="case__title">{section.title.split(' — ')[0]}{section.title.includes(' — ') && <span class="case__title-rest"> — {section.title.split(' — ').slice(1).join(' — ')}</span>}</h2>
                  <div class="case__gallery">
                    <div class="case__slider" data-case-slider>
                      <div class="case__stage">
                        <img data-case-main src={section.images[0].main} alt={`${section.title} preview`} width="1100" height="733" decoding="async" />
                        <button class="case__arrow case__arrow--prev" type="button" data-case-prev aria-label="Previous image">
                          <svg viewBox="0 0 16 15" fill="none" aria-hidden="true"><path d="M0 6.92309H13.8418L9.096 2.0772L10.1243 1.5L16 7.5L10.1243 13.5L9.096 12.9228L13.8418 8.07693H0Z" fill="currentColor"></path></svg>
                        </button>
                        <button class="case__arrow case__arrow--next" type="button" data-case-next aria-label="Next image">
                          <svg viewBox="0 0 16 15" fill="none" aria-hidden="true"><path d="M0 6.92309H13.8418L9.096 2.0772L10.1243 1.5L16 7.5L10.1243 13.5L9.096 12.9228L13.8418 8.07693H0Z" fill="currentColor"></path></svg>
                        </button>
                      </div>
                      <div class="case__thumbs">
                        {section.images.map((image, imageIndex) => (
                          <button
                            class={imageIndex === 0 ? 'case__thumb is-active' : 'case__thumb'}
                            type="button"
                            data-case-thumb
                            data-main={image.main}
                            aria-label={`Show image ${imageIndex + 1}`}
                          >
                            <img src={image.thumb} alt="" width="320" height="213" decoding="async" />
                          </button>
                        ))}
                      </div>
                    </div>
                    <aside class="case__card">
                      <div>
                        <p class="case__name">{section.title}</p>
                        <ul class="case__tags">{section.tags.filter((tag) => !/webflow/i.test(tag)).map((tag) => <li>{tag}</li>)}</ul>
                      </div>
                      <div>
                        <p class="case__label">{section.about?.label ?? 'What I built'}</p>
                        <p class="case__text">{section.about?.text ?? section.description}</p>
                        <div class="case__actions">
                          <button class="case__button case__button--light" type="button" data-case-more>More info</button>
                          {section.liveUrl && <a class="case__button case__button--dark" href={section.liveUrl} target="_blank" rel="noreferrer">View project</a>}
                        </div>
                      </div>
                    </aside>
                  </div>
                </>
              )}
            </section>
          ))}
        </div>
      ))}
    </div>
    <div class="scroll-cue" aria-hidden="true">
      <svg class="cue__touch" viewBox="0 0 36 72" fill="none">
        <g class="cue__hand"><g transform="translate(3 30) scale(1.4)"><path class="cue__finger" d="M8 13v-8.5a1.5 1.5 0 0 1 3 0v7.5M11 11.5v-2a1.5 1.5 0 1 1 3 0v2.5M14 10.5a1.5 1.5 0 0 1 3 0v1.5M17 11.5a1.5 1.5 0 0 1 3 0v4.5a6 6 0 0 1 -6 6h-2h.208a6 6 0 0 1 -5.012 -2.7a69.74 69.74 0 0 1 -.196 -.3c-.312 -.479 -1.407 -2.388 -3.286 -5.728a1.5 1.5 0 0 1 .536 -2.022a1.867 1.867 0 0 1 2.28 .28l1.47 1.47" vector-effect="non-scaling-stroke"></path></g></g>
      </svg>
      <svg class="cue__mouse" viewBox="0 0 36 72" fill="none">
        <rect class="cue__body" x="3" y="2" width="30" height="48" rx="15" pathLength="1"></rect>
        <line class="cue__wheel" x1="18" y1="12" x2="18" y2="20"></line>
        <path class="cue__chevron cue__chevron--1" d="M12.5 57l5.5 4.5 5.5-4.5"></path>
        <path class="cue__chevron cue__chevron--2" d="M12.5 63l5.5 4.5 5.5-4.5"></path>
      </svg>
    </div>
  </div>
  {cases.map((project) => (
    <template data-detail={project.id}>
      {detailParts(project).map((part, groupIndex, groups) => (
        <section class="screen detail-screen" data-num={String(groupIndex + 1).padStart(2, '0')}>
          <div class="detail__head">
            <h2 class="detail__title">{project.title.split(' — ')[0]}{project.title.includes(' — ') && <span class="detail__title-rest"> — {project.title.split(' — ').slice(1).join(' — ')}</span>}</h2>
            <span class="detail__count">{String(groupIndex + 1).padStart(2, '0')} / {String(groups.length).padStart(2, '0')}</span>
            {groupIndex === 0 && project.liveUrl && (
              <a class="case__button case__button--dark" href={project.liveUrl} target="_blank" rel="noreferrer">View project</a>
            )}
            <button class="detail__close" type="button" data-detail-close aria-label="Close"><span class="detail__close-text">Close</span><svg class="detail__close-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg></button>
          </div>
          <div class="detail__body">
            {groupIndex === 0 && (
              <div class="detail__intro">
                {project.subtitle && <p class="detail__lead">{project.subtitle}</p>}
                {project.metrics.length > 0 && (
                  <dl class="detail__metrics">
                    {project.metrics.map((metric) => (
                      <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>
                    ))}
                  </dl>
                )}
              </div>
            )}
            {part.kind === 'diagram' && project.diagram && (
              <div class="detail__intro">
                <p class="detail__lead">{project.diagram.title}</p>
                <div class="detail__flow">
                  {project.diagram.nodes.map((node) => (
                    <div class={`detail__node detail__node--${node.kind ?? 'plain'}`} style={`grid-column:${node.col};grid-row:${node.row}`}>
                      {node.kind === 'auto' && <span class="detail__badge">Auto</span>}
                      {node.kind === 'human' && (
                        <span class="detail__badge">
                          <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="4" r="2.2" /><path d="M1.8 11c.4-2.4 2.1-3.6 4.2-3.6s3.8 1.2 4.2 3.6" /></svg>
                          Human
                        </span>
                      )}
                      <h3>{node.name}</h3>
                      <ul>{node.notes.map((note) => <li>{note}</li>)}</ul>
                    </div>
                  ))}
                  {project.diagram.links.map((link) => (
                    <div class={`detail__link detail__link--${link.dir}`} style={`grid-column:${link.col};grid-row:${link.row}`} aria-hidden="true">
                      <span class="detail__label">{link.label}</span>
                      <div class="detail__line">
                        <i></i>
                        {link.dir === 'up' ? (
                          <svg viewBox="0 0 10 8" aria-hidden="true"><path d="M0 8L5 0L10 8Z" fill="currentColor"></path></svg>
                        ) : link.dir === 'down' ? (
                          <svg viewBox="0 0 10 8" aria-hidden="true"><path d="M0 0L5 8L10 0Z" fill="currentColor"></path></svg>
                        ) : (
                          <svg viewBox="0 0 8 10" aria-hidden="true"><path d="M0 0L8 5L0 10Z" fill="currentColor"></path></svg>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {part.kind === 'rows' && (
              <div class="detail__rows">
                {part.rows.map((row) => (
                  <div class="detail__row">
                    <h3>{row.title}</h3>
                    <div>
                      {row.texts.map((text) => <p>{text}</p>)}
                      {row.chips.length > 0 && <ul class="detail__chips">{row.chips.map((chip) => <li>{chip}</li>)}</ul>}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
          <div class="detail__visual">
            <img src={project.images[(groupIndex + 1) % project.images.length].main} alt="" width="1536" height="1024" decoding="async" />
          </div>
        </section>
      ))}
    </template>
  ))}
  <template data-detail="more-works">
    {worksPages.map((page, pageIndex) => (
      <section class="screen detail-screen detail-screen--works" data-num={String(pageIndex + 1).padStart(2, '0')}>
        <div class="detail__head">
          <h2 class="detail__title">More works</h2>
          <span class="detail__count">{String(pageIndex + 1).padStart(2, '0')} / {String(worksPages.length).padStart(2, '0')}</span>
          <button class="detail__close" type="button" data-detail-close aria-label="Close"><span class="detail__close-text">Close</span><svg class="detail__close-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg></button>
        </div>
        <div class="more__grid">
          {page.map((work) => (
            <a class="works__card" href={work.url} target="_blank" rel="noreferrer">
              <span class="works__shot"><img src={work.image} alt={`${work.name} website`} width="1530" height="900" loading="lazy" decoding="async" /></span>
              <span class="works__name">{work.name}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            </a>
          ))}
        </div>
        {pageIndex === worksPages.length - 1 && <p class="more__nda">And many more — unfortunately under NDA.</p>}
      </section>
    ))}
  </template>
</div>

<script>
  import { gsap } from 'gsap';
  import { contactSky, heroSky, skyFragment, skyScaleFar, skyScaleNear, skyVertex, type SkyPalette } from './skyShader';

  const root = document.querySelector<HTMLElement>('[data-experience]');
  const camera = root?.querySelector<HTMLElement>('[data-camera]');

  if (root && camera) {
    if (navigator.maxTouchPoints > 0 || 'ontouchstart' in window) root.classList.add('is-touch');
    // Phones (iOS Safari above all) run out of graphics memory with the desktop setup: a 3D / will-change camera
    // layer is rasterized at full size, and in the zoomed-out overview that is the whole multi-lap world (hundreds of
    // MB), which crashes the tab right around the end of the preloader. Light mode keeps every transform 2D, gives
    // nothing a permanent layer and reveals the content without per-element fades.
    const lowMemory = root.classList.contains('is-touch') || window.matchMedia('(max-width: 700px), (pointer: coarse)').matches;
    if (lowMemory) {
      root.classList.add('is-light');
      gsap.defaults({ force3D: false });
    }
    const count = Number(root.dataset.count ?? 6);
    let cycleX = Number(root.dataset.cycleX ?? 3840);
    let cycleY = Number(root.dataset.cycleY ?? 2160);
    // clone the server-rendered lap into slots -1, 1 and 2 (the page has a single h1: the copies get a <p>)
    const sourceCycle = root.querySelector<HTMLElement>('[data-cycle]');
    if (sourceCycle) {
      [-1, 1, 2].forEach((slot) => {
        const copy = sourceCycle.cloneNode(true) as HTMLElement;
        copy.dataset.slot = String(slot);
        copy.querySelectorAll('h1').forEach((heading) => {
          const text = document.createElement('p');
          text.className = heading.className;
          [...heading.attributes].forEach((attribute) => text.setAttribute(attribute.name, attribute.value));
          text.append(...heading.childNodes);
          heading.replaceWith(text);
        });
        if (slot < 0) sourceCycle.before(copy);
        else camera.append(copy);
      });
    }
    const cycles = [...root.querySelectorAll<HTMLElement>('[data-cycle]')];
    const screens = [...root.querySelectorAll<HTMLElement>('[data-screen]')];
    // Ice palette
    const activePalette: string[] = JSON.parse(root.dataset.colors ?? '[]');
    const grid: number[][] = JSON.parse(root.dataset.grid ?? '[]');
    const lapX = Number(root.dataset.lapX ?? 3);
    const lapY = Number(root.dataset.lapY ?? 3);
    let screenWidth = 1280;
    let screenHeight = 720;
    let points: number[][] = [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let introTarget = 0;
    let intro = 0;
    let positionTarget = 0;
    let position = 0;
    let lastCycle = Number.NaN;
    let touchY = 0;
    let ready = false;
    let detailOpen = false;
    let flickerTimer: number | undefined;
    // last camera transform written, so a page at rest does not restyle the camera every frame
    let cameraKey = '';
    const writeCamera = (x: number, y: number, scale: number) => {
      const key = `${x.toFixed(2)}|${y.toFixed(2)}|${scale.toFixed(5)}`;
      if (key === cameraKey) return;
      cameraKey = key;
      gsap.set(camera, { x, y, scale, transformOrigin: '0 0' });
    };
    let preloaderTimeline: gsap.core.Timeline | null = null;

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const smooth = (value: number) => value * value * (3 - 2 * value);
    const modulo = (value: number, divisor: number) => ((value % divisor) + divisor) % divisor;
    const mix = (from: number, to: number, amount: number) => from + (to - from) * amount;

    const layoutGeometry = () => {
      const desktop = window.innerWidth > 700;
      screenWidth = Math.max(320, window.innerWidth * (desktop ? .95 : .98));
      screenHeight = Math.max(320, window.innerHeight);
      cycleX = screenWidth * lapX;
      cycleY = screenHeight * lapY;
      const positions = grid.map(([column, row]) => [column * screenWidth, row * screenHeight]);
      points = positions.map(([x, y]) => [x + screenWidth / 2, y + screenHeight / 2]);

      screens.forEach((screen) => {
        const index = Number(screen.dataset.screen ?? 0);
        const position = positions[index] ?? positions[0];
        gsap.set(screen, {
          left: position[0],
          top: position[1],
          width: screenWidth + 1,
          height: screenHeight + 1,
        });
      });

      lastCycle = Number.NaN;
      cameraKey = '';
      layoutCycles(Math.floor(position / count));
    };

    const inkFor = (hex: string) => {
      const value = hex.replace('#', '');
      const red = Number.parseInt(value.slice(0, 2), 16);
      const green = Number.parseInt(value.slice(2, 4), 16);
      const blue = Number.parseInt(value.slice(4, 6), 16);
      const luminance = (red * .299 + green * .587 + blue * .114) / 255;
      return luminance > .56 ? '#111111' : '#f7f4ec';
    };

    const applyPalette = () => {
      screens.forEach((screen) => {
        const screenIndex = Number(screen.dataset.screen ?? 0);
        const color = activePalette[screenIndex % activePalette.length] ?? activePalette[0];
        screen.style.setProperty('--color', color);
        screen.style.setProperty('--ink', inkFor(color));
        screen.dataset.tone = inkFor(color) === '#111111' ? 'light' : 'dark';
      });
    };

    applyPalette();

    const view = () => ({
      overviewX: points[0][0],
      overviewY: points[0][1],
      overviewScale: Math.min(
        (window.innerWidth / 2 - 24) / (cycleX + screenWidth * .5),
        (window.innerHeight / 2 - 24) / (cycleY - screenHeight * .5),
      ),
      focusedScale: 1,
    });

    const setOverviewCamera = () => {
      const { overviewX, overviewY, overviewScale } = view();
      gsap.set(camera, {
        x: window.innerWidth / 2 - overviewX * overviewScale,
        y: window.innerHeight / 2 - overviewY * overviewScale,
        scale: overviewScale,
        transformOrigin: '0 0',
      });
    };

    const pointAt = (value: number) => {
      const cycle = Math.floor(value / count);
      const local = modulo(value, count);
      const index = Math.floor(local);
      const amount = smooth(local - index);
      const current = points[index] ?? points[0];
      const next = index === count - 1 ? points[0] : points[index + 1];
      const nextCycle = index === count - 1 ? cycle + 1 : cycle;

      return {
        cycle,
        x: mix(current[0] + cycle * cycleX, next[0] + nextCycle * cycleX, amount),
        y: mix(current[1] + cycle * cycleY, next[1] + nextCycle * cycleY, amount),
      };
    };

    const layoutCycles = (centerCycle: number) => {
      if (centerCycle === lastCycle) return;
      lastCycle = centerCycle;
      cycles.forEach((cycleElement) => {
        const slot = Number(cycleElement.dataset.slot ?? 0);
        const cycleIndex = centerCycle + slot;
        gsap.set(cycleElement, { x: cycleIndex * cycleX, y: cycleIndex * cycleY });
      });
    };

    layoutGeometry();
    root.classList.add('is-loading');
    setOverviewCamera();
    // Reveal only after the camera sits in the overview, so the unscaled first paint is never visible.
    requestAnimationFrame(() => root.classList.add('is-staged'));
    window.addEventListener('resize', layoutGeometry, { passive: true });

    const addMovement = (delta: number) => {
      if (!ready || flying) return;
      if (detailOpen) {
        // the open cases are part of the page: scrolling carries on along one endless path
        if (detailFree) {
          if (detailTarget <= .001) {
            // same as the normal route: at the very first hero, scrolling up pulls back to the overview
            if (introTarget < 1 && delta > 0) {
              introTarget = clamp(introTarget + delta * .0017, 0, 1);
              return;
            }
            if (delta < 0) {
              introTarget = clamp(introTarget + delta * .0017, 0, 1);
              return;
            }
          }
          detailTarget = Math.max(0, detailTarget + delta * .0009);
        }
        return;
      }
      if (introTarget < 1 && delta > 0) {
        introTarget = clamp(introTarget + delta * .0017, 0, 1);
        return;
      }
      if (introTarget > 0 && delta < 0 && positionTarget <= .001) {
        introTarget = clamp(introTarget + delta * .0017, 0, 1);
        return;
      }
      positionTarget = Math.max(0, positionTarget + delta * .00088);
    };

    root.addEventListener('wheel', (event) => {
      event.preventDefault();
      addMovement(event.deltaY);
    }, { passive: false });

    root.addEventListener('touchstart', (event) => {
      touchY = event.touches[0]?.clientY ?? 0;
    }, { passive: true });

    root.addEventListener('touchmove', (event) => {
      const nextY = event.touches[0]?.clientY ?? touchY;
      const delta = touchY - nextY;
      touchY = nextY;
      event.preventDefault();
      addMovement(delta * 3.1); // a swipe travels ~40% further than it used to
    }, { passive: false });

    root.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].includes(event.key)) {
        event.preventDefault();
        addMovement(220);
      }
      if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        addMovement(-220);
      }
    });

    const startPreloader = () => {
      preloaderTimeline?.kill();
      if (flickerTimer !== undefined) window.clearInterval(flickerTimer);

      introTarget = 0;
      intro = 0;
      positionTarget = 0;
      position = 0;
      lastCycle = Number.NaN;
      ready = false;
      root.classList.remove('is-ready', 'has-entered');

      const { overviewX, overviewY, overviewScale } = view();
      const baseX = window.innerWidth / 2 - overviewX * overviewScale;
      const baseY = window.innerHeight / 2 - overviewY * overviewScale;
      const nextCycleX = baseX - cycleX * overviewScale;
      const nextCycleY = baseY - cycleY * overviewScale;
      let colorStep = 0;
      screens.forEach((screen, index) => {
        screen.style.setProperty('--flash-color', activePalette[index % activePalette.length] ?? activePalette[0]);
      });

      root.classList.add('is-loading');
      layoutCycles(0);
      gsap.set(camera, { x: baseX, y: baseY, scale: overviewScale, transformOrigin: '0 0' });

      flickerTimer = window.setInterval(() => {
        colorStep += 1;
        screens.forEach((screen, index) => {
          screen.style.setProperty('--flash-color', activePalette[(index + colorStep) % activePalette.length] ?? activePalette[0]);
        });
      }, reduced.matches ? 240 : lowMemory ? 150 : 95);

      preloaderTimeline = gsap.timeline({
        onComplete: () => {
          if (flickerTimer !== undefined) window.clearInterval(flickerTimer);
          flickerTimer = undefined;
          preloaderTimeline = null;
          screens.forEach((screen) => screen.style.removeProperty('--flash-color'));
          gsap.set(camera, { x: baseX, y: baseY, scale: overviewScale });
          cameraKey = '';
          root.classList.remove('is-loading');
          root.classList.add('is-ready');
          ready = true;
          root.focus({ preventScroll: true });
        },
      })
        .to(camera, {
          x: nextCycleX,
          y: nextCycleY,
          duration: reduced.matches ? .8 : 3.2,
          ease: 'none',
        });
    };

    // Start only once the page and fonts are ready, so nothing reflows during the zoom
    const pageLoaded = document.readyState === 'complete'
      ? Promise.resolve()
      : new Promise<void>((resolve) => window.addEventListener('load', () => resolve(), { once: true }));
    const fontsLoaded = Promise.race([
      Promise.all([
        document.fonts.load('600 100px "DM Sans"'),
        document.fonts.load('500 100px "DM Sans"'),
        document.fonts.load('400 16px Inter'),
        document.fonts.load('300 16px Inter'),
        document.fonts.load('500 12px Inter'),
      ]),
      new Promise((resolve) => window.setTimeout(resolve, 2500)),
    ]);
    // skyWarm (below) compiles both shaders and paints every canvas once; the preloader waits for it too
    Promise.all([pageLoaded, fontsLoaded]).then(() => skyWarm).then(startPreloader);


    // Case slider: arrows and previews swap the big image (the next image is decoded before the swap)
    // Slider: the next picture slides/fades in over the current one. When it lands it simply becomes the main
    // picture (the old <img> is removed), so nothing is re-decoded and nothing flashes.
    const slideTweens = new WeakMap<HTMLElement, gsap.core.Tween>();
    const showSlide = (screen: HTMLElement, index: number, direction = 0) => {
      const stage = screen.querySelector<HTMLElement>('.case__stage');
      const thumbs = [...screen.querySelectorAll<HTMLElement>('[data-case-thumb]')];
      if (!stage || !thumbs.length) return;

      // finish a slide that is still running so quick clicks never stack up
      slideTweens.get(stage)?.progress(1);
      const main = stage.querySelector<HTMLImageElement>('[data-case-main]');
      if (!main) return;

      const next = (index + thumbs.length) % thumbs.length;
      const current = Number(screen.dataset.slide ?? 0);
      if (next === current) return;
      const url = thumbs[next].dataset.main ?? main.src;
      const dir = direction || Math.sign(next - current) || 1;
      thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === next));
      screen.dataset.slide = String(next);

      const incoming = main.cloneNode() as HTMLImageElement;
      incoming.removeAttribute('data-case-main');
      incoming.src = url;
      incoming.decode().catch(() => {}).then(() => {
        if (screen.dataset.slide !== String(next) || !main.isConnected) return;
        main.after(incoming);
        const slow = reduced.matches ? 0 : 1;
        gsap.set(incoming, { xPercent: dir * 7 * slow, opacity: 0 });
        slideTweens.set(stage, gsap.to(incoming, {
          xPercent: 0,
          opacity: 1,
          duration: .55 * slow,
          ease: 'power3.out',
          onUpdate() { gsap.set(main, { xPercent: -dir * 3 * slow * this.progress() }); },
          onComplete: () => {
            main.remove();
            incoming.setAttribute('data-case-main', '');
            gsap.set(incoming, { clearProps: 'transform,opacity' });
            slideTweens.delete(stage);
          },
        }));
      });
    };

    // Swipe (touch, pen or mouse drag) on the picture changes the slide; vertical moves still travel the scene
    let swipe: { x: number; y: number; screen: HTMLElement } | null = null;
    root.addEventListener('pointerdown', (event) => {
      const target = event.target as HTMLElement;
      const stage = target.closest<HTMLElement>('.case__stage');
      const screen = stage?.closest<HTMLElement>('.screen');
      swipe = stage && screen && !target.closest('.case__arrow') ? { x: event.clientX, y: event.clientY, screen } : null;
    });
    root.addEventListener('pointerup', (event) => {
      if (!swipe) return;
      const dx = event.clientX - swipe.x;
      const dy = event.clientY - swipe.y;
      const { screen } = swipe;
      swipe = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        showSlide(screen, Number(screen.dataset.slide ?? 0) + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      }
    });
    root.addEventListener('pointercancel', () => { swipe = null; });

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const screen = target.closest<HTMLElement>('.screen');
      if (!screen) return;
      // "Go to works" / "Contact me": the first case or the contact screen of the clicked hero's own lap
      const goWorks = target.closest('[data-go-works]');
      if (goWorks || target.closest('[data-go-contact]')) {
        if (!ready || detailBusy || flying) return;
        // the closest copy of the wanted screen (first case / contact), whichever lap it is on
        const index = goWorks ? 1 : count - 1;
        const from = valueOf(screen);
        let value = Math.round((from - index) / count) * count + index;
        if (value < 0) value += count;
        if (detailOpen) {
          introTarget = 1;
          detailTarget = seqOf(value);
        } else flyTo(value);
        return;
      }
      if (target.closest('[data-case-more]')) {
        openDetail(screen);
        return;
      }
      if (target.closest('[data-detail-close]')) {
        const section = target.closest<HTMLElement>('.detail-screen');
        closeDetail(runs.find((run) => section && run.sections.includes(section)));
        return;
      }
      const current = Number(screen.dataset.slide ?? 0);
      if (target.closest('[data-case-prev]')) showSlide(screen, current - 1, -1);
      else if (target.closest('[data-case-next]')) showSlide(screen, current + 1, 1);
      else {
        const thumb = target.closest<HTMLElement>('[data-case-thumb]');
        if (thumb) showSlide(screen, [...screen.querySelectorAll('[data-case-thumb]')].indexOf(thumb));
      }
    });

    // "More info": the camera pulls back, everything that comes after the case slides down, the detail sections come
    // out from under the case and the camera zooms into them. Any number of cases can be open at once. While at
    // least one is open the scroll path is one endless sequence of "steps": every screen of the route plus the detail
    // sections inserted after their case (see stopAt). Only transforms are animated.
    type DetailRun = {
      value: number; // route position of the case (lap * count + screen index)
      n: number;
      total: number;
      sections: HTMLElement[];
      left: number;
      top: number;
      cx: number;
      cy: number;
    };

    const cam = { cx: 0, cy: 0, scale: 1 };
    const runs: DetailRun[] = [];
    let detailFree = false;
    let detailBusy = false;
    let detailPos = 0;
    let detailTarget = 0;

    const applyCamera = () => {
      writeCamera(window.innerWidth / 2 - cam.cx * cam.scale, window.innerHeight / 2 - cam.cy * cam.scale, cam.scale);
    };

    // how many detail slots lie before a screen of the route, and the matching shift down
    const slotsBefore = (value: number) => runs.reduce((sum, run) => (run.value < value ? sum + run.n : sum), 0);
    const shiftBefore = (value: number) => slotsBefore(value) * screenHeight;
    const seqOf = (value: number) => value + slotsBefore(value);
    const valueOf = (element: HTMLElement) =>
      (lastCycle + cycles.indexOf(element.parentElement as HTMLElement) - 1) * count + Number(element.dataset.screen);

    // what the camera looks at for step `seq`: a screen of the route, or one of the detail sections
    const stopAt = (seq: number) => {
      let offset = 0;
      for (const run of runs) {
        const caseSeq = run.value + offset;
        if (seq <= caseSeq) break;
        if (seq <= caseSeq + run.n) {
          return { x: run.cx, y: run.cy + shiftBefore(run.value) + screenHeight * (seq - caseSeq), value: run.value };
        }
        offset += run.n;
      }
      const value = seq - offset;
      const route = pointAt(value);
      return { x: route.x, y: route.y + shiftBefore(value), value };
    };

    const placeSections = (run: DetailRun) => {
      run.sections.forEach((section, index) => {
        gsap.set(section, { left: run.left, top: run.top + shiftBefore(run.value) + screenHeight * (index + 1), y: 0 });
      });
    };

    // make every loaded screen and section match the open cases (also after the laps were re-laid out)
    const syncPush = () => {
      screens.forEach((element) => {
        const shift = shiftBefore(valueOf(element));
        gsap.set(element, shift ? { y: shift } : { clearProps: 'transform' });
      });
      runs.forEach(placeSections);
    };

    const nearestRun = () => runs.reduce<DetailRun | null>((best, run) => {
      const distance = Math.abs(seqOf(run.value) + run.n / 2 - detailPos);
      return !best || distance < Math.abs(seqOf(best.value) + best.n / 2 - detailPos) ? run : best;
    }, null);

    // screens (and the sections of other open cases) that come after the case and so have to move
    const collectMoving = (value: number, caseCy: number) => {
      const near: HTMLElement[] = [];
      const far: HTMLElement[] = [];
      screens.forEach((element) => {
        const other = valueOf(element);
        if (other <= value) return;
        const distance = (pointAt(other).y + shiftBefore(other) - caseCy) / screenHeight;
        (distance <= 6 ? near : far).push(element);
      });
      const sections = runs.filter((run) => run.value > value).flatMap((run) => run.sections);
      return { near, far, sections };
    };

    const openDetail = (screen: HTMLElement) => {
      if (!ready || detailBusy) return;
      const template = root.querySelector<HTMLTemplateElement>(`template[data-detail="${screen.dataset.case}"]`);
      if (!template) return;
      const value = valueOf(screen);
      if (runs.some((run) => run.value === value)) return;
      const sections = [...template.content.children].map((node) => node.cloneNode(true) as HTMLElement);
      if (!sections.length) return;

      const slow = reduced.matches ? .4 : 1;
      const route = pointAt(value);
      const run: DetailRun = {
        value,
        n: sections.length,
        total: sections.length * screenHeight,
        sections,
        left: route.x - screenWidth / 2,
        top: route.y - screenHeight / 2,
        cx: route.x,
        cy: route.y,
      };
      const caseShift = shiftBefore(value); // cases that are already open have moved this one
      const caseCy = run.cy + caseShift;
      const farScale = Math.min(.5, window.innerHeight / ((run.n + 1.8) * screenHeight), window.innerWidth / (screenWidth * 1.9));

      // start from wherever the camera is now
      const scaleNow = Number(gsap.getProperty(camera, 'scale'));
      cam.scale = scaleNow;
      cam.cx = (window.innerWidth / 2 - Number(gsap.getProperty(camera, 'x'))) / scaleNow;
      cam.cy = (window.innerHeight / 2 - Number(gsap.getProperty(camera, 'y'))) / scaleNow;

      detailOpen = true;
      detailBusy = true;
      detailFree = false;
      root.classList.add('is-detail');

      sections.forEach((section, index) => {
        section.style.setProperty('--color', screen.style.getPropertyValue('--color'));
        section.dataset.tone = screen.dataset.tone ?? 'light';
        // each section waits exactly behind the case (y offset) and slides down to its own slot
        gsap.set(section, {
          left: run.left,
          top: run.top + caseShift + screenHeight * (index + 1),
          width: screenWidth + 1,
          height: screenHeight + 1,
          y: -screenHeight * (index + 1),
          zIndex: -(index + 1),
        });
        camera.append(section);
      });

      // Only the screens that can be seen while zoomed out are animated; the far ones just jump. The moving ones get
      // their own layer (will-change) while the camera is still at scale 1, so the browser rasters them once at full
      // size instead of re-rastering every frame while the camera zooms.
      const { near, far, sections: later } = collectMoving(value, caseCy);
      gsap.set(far, { y: `+=${run.total}` });
      const moving = [...sections, ...near, ...later];
      if (!lowMemory) moving.forEach((element) => { element.style.willChange = 'transform'; });

      gsap.timeline({
        onComplete: () => {
          moving.forEach((element) => { element.style.willChange = ''; });
          runs.push(run);
          runs.sort((a, b) => a.value - b.value);
          syncPush();
          detailBusy = false;
          detailFree = true;
          detailPos = seqOf(value) + 1;
          detailTarget = detailPos;
          position = value;
          positionTarget = value;
          sections[0].querySelector<HTMLElement>('[data-detail-close]')?.focus({ preventScroll: true });
        },
      })
        .to(cam, { cx: run.cx, cy: caseCy + run.total / 2, scale: farScale, duration: .95 * slow, ease: 'power3.inOut' }, 0)
        // the sections come out from under the case and push everything after it down with the same move
        .to(sections, { y: 0, duration: 1.1 * slow, ease: 'power3.inOut' }, .25 * slow)
        .to([...near, ...later], { y: `+=${run.total}`, duration: 1.1 * slow, ease: 'power3.inOut' }, .25 * slow)
        .to(cam, { cx: run.cx, cy: caseCy + screenHeight, scale: 1, duration: 1.05 * slow, ease: 'power3.inOut' }, 1.35 * slow);
    };

    const closeDetail = (target?: DetailRun | null) => {
      const run = target ?? nearestRun();
      if (!run || detailBusy) return;
      const slow = reduced.matches ? .4 : 1;
      const caseCy = run.cy + shiftBefore(run.value);
      const farScale = Math.min(.5, window.innerHeight / ((run.n + 1.8) * screenHeight), window.innerWidth / (screenWidth * 1.9));
      detailBusy = true;
      detailFree = false;
      intro = 1;
      introTarget = 1;

      // the user may have scrolled many laps away: bring the laps around this case back so it can be animated
      const runLap = Math.floor(run.value / count);
      if (Math.abs(Math.floor(position / count) - runLap) > 1) {
        layoutCycles(runLap);
        syncPush();
        cam.cx = run.cx;
        cam.cy = caseCy + run.total / 2;
        cam.scale = farScale;
      }

      const { near, far, sections: later } = collectMoving(run.value, caseCy);
      gsap.set(far, { y: `-=${run.total}` });
      const moving = [...run.sections, ...near, ...later];
      if (!lowMemory) moving.forEach((element) => { element.style.willChange = 'transform'; });

      gsap.timeline({
        onComplete: () => {
          moving.forEach((element) => { element.style.willChange = ''; });
          run.sections.forEach((section) => section.remove());
          runs.splice(runs.indexOf(run), 1);
          syncPush();
          detailBusy = false;
          position = run.value;
          positionTarget = run.value;
          if (runs.length) {
            detailFree = true;
            detailPos = seqOf(run.value);
            detailTarget = detailPos;
          } else {
            detailOpen = false;
            detailFree = false;
            root.classList.remove('is-detail');
            root.focus({ preventScroll: true });
          }
        },
      })
        .to(cam, { cx: run.cx, cy: caseCy + run.total / 2, scale: farScale, duration: .95 * slow, ease: 'power3.inOut' }, 0)
        // the sections slide back under the case and the rest of the page rises with them
        .to(run.sections, { y: (index: number) => -screenHeight * (index + 1), duration: 1.1 * slow, ease: 'power3.inOut' }, .4 * slow)
        .to([...near, ...later], { y: `-=${run.total}`, duration: 1.1 * slow, ease: 'power3.inOut' }, .4 * slow)
        .to(cam, { cx: run.cx, cy: caseCy, scale: 1, duration: 1 * slow, ease: 'power3.inOut' }, 1.45 * slow);
    };

    // drop every open case at once (used when the window is resized: the sections are sized only once)
    const resetDetails = () => {
      runs.forEach((run) => run.sections.forEach((section) => section.remove()));
      runs.length = 0;
      syncPush();
      position = Math.round(position);
      positionTarget = position;
      detailOpen = false;
      detailBusy = false;
      detailFree = false;
      root.classList.remove('is-detail');
    };

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetail();
    });
    window.addEventListener('resize', () => { if (detailOpen) resetDetails(); }, { passive: true });

    // Hero sky: one WebGL shader paints the hero canvases. Kept cheap: a small canvas, 4 noise octaves, only
    // while a hero is on screen, every frame only while something moves (mouse / scroll) and otherwise just the
    // slow drift at ~15 fps. Until the first frame the canvas shows the static picture (CSS background).
    // the long side is 448px; the short side follows the screen, so the clouds are never stretched (phones)
    const skySize = () => {
      const long = 448;
      return screenWidth >= screenHeight
        ? [long, Math.round(long * screenHeight / screenWidth)]
        : [Math.round(long * screenWidth / screenHeight), long];
    };
    let [skyWidth, skyHeight] = skySize();
    const skyCanvases = (selector: string) => [...root.querySelectorAll<HTMLCanvasElement>(selector)].map((canvas) => {
      canvas.width = skyWidth;
      canvas.height = skyHeight;
      return canvas.getContext('2d');
    });
    const skyContexts = skyCanvases('[data-sky]');
    const contactContexts = skyCanvases('[data-sky-contact]');
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    window.addEventListener('pointermove', (event) => {
      pointer.tx = event.clientX / window.innerWidth - .5;
      pointer.ty = .5 - event.clientY / window.innerHeight;
    }, { passive: true });

    const createSky = () => {
      const canvas = document.createElement('canvas');
      canvas.width = skyWidth;
      canvas.height = skyHeight;
      const gl = canvas.getContext('webgl', { antialias: false, depth: false, stencil: false });
      if (!gl) return null;
      const compile = (type: number, source: string) => {
        const shader = gl.createShader(type)!;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return shader;
      };
      const program = gl.createProgram()!;
      gl.attachShader(program, compile(gl.VERTEX_SHADER, skyVertex));
      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, skyFragment));
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return null;
      gl.useProgram(program);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'aPos');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(program, 'uRes');
      const fit = () => {
        canvas.width = skyWidth;
        canvas.height = skyHeight;
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
      };
      fit();
      const uTime = gl.getUniformLocation(program, 'uTime');
      const uMouse = gl.getUniformLocation(program, 'uMouse');
      const uScale = gl.getUniformLocation(program, 'uScale');
      const uShift = gl.getUniformLocation(program, 'uShift');
      const uColors = ['uBaseA', 'uBaseB', 'uTintA', 'uTintB', 'uTintC'].map((name) => gl.getUniformLocation(program, name));
      const paint = (time: number, x: number, y: number, scale: number, shift: number, slots: number[], palette: SkyPalette = heroSky, targets = skyContexts) => {
        uColors.forEach((location, index) => gl.uniform3fv(location, palette[index]));
        gl.uniform1f(uTime, time);
        gl.uniform2f(uMouse, x, y);
        gl.uniform1f(uScale, scale);
        gl.uniform1f(uShift, shift);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        slots.forEach((slot) => targets[slot]?.drawImage(canvas, 0, 0));
      };
      return { paint, fit };
    };
    const sky = createSky();
    const paintSky = sky?.paint;
    let skyClock = 20;
    // Every screen with a sky: its route index, palette and canvases (one per lap copy). A clock offset keeps the
    // screens that share a palette from showing the same clouds.
    const skies = [
      { index: 0, palette: heroSky, contexts: skyContexts, offset: 0, painted: 0, shift: 0, slot: -1 },
      { index: count - 1, palette: contactSky, contexts: contactContexts, offset: 37, painted: 0, shift: 0, slot: -1 },
    ];
    const allSlots = cycles.map((_, index) => index);
    // Warm-up: paint every canvas once with each palette and let the GPU finish (plus two frames to upload the
    // 2D canvases) before the site starts, so the first real frames are cheap.
    const paintAllSkies = () => skies.forEach((item) => paintSky?.(skyClock + item.offset, pointer.x, pointer.y, skyScaleFar, 0, allSlots, item.palette, item.contexts));
    const skyWarm = new Promise<void>((resolve) => {
      paintAllSkies();
      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      window.setTimeout(resolve, 400); // a background tab gets no animation frames: never hold the start on them
    });

    // a new screen shape (rotation, resize) gets canvases of the new shape, painted once right away
    window.addEventListener('resize', () => {
      const [width, height] = skySize();
      if (width === skyWidth && height === skyHeight) return;
      skyWidth = width;
      skyHeight = height;
      skies.forEach((item) => item.contexts.forEach((context) => {
        if (!context) return;
        context.canvas.width = width;
        context.canvas.height = height;
      }));
      sky?.fit();
      paintAllSkies();
    }, { passive: true });

    // runs after the camera ticker (registered at the end), so it always sees this frame's lap layout
    const tickSky = (_time: number, deltaTime: number) => {
      if (!paintSky || document.hidden || !ready) return;
      // signed distance (in screens) from each sky screen to the camera; a sky is painted only within one screen
      const near = skies
        .map((sky) => ({ sky, distance: modulo(position - sky.index + count / 2, count) - count / 2 }))
        .filter(({ distance }) => Math.abs(distance) < 1);
      if (!near.length) return;

      skyClock += Math.min(deltaTime, 100) / 1000;
      const dx = pointer.tx - pointer.x;
      const dy = pointer.ty - pointer.y;
      pointer.x += dx * .06;
      pointer.y += dy * .06;
      const pointerMoving = Math.abs(dx) + Math.abs(dy) > .0005;
      const scale = mix(skyScaleFar, skyScaleNear, smooth(intro));

      near.forEach(({ sky, distance }) => {
        // scrolling pulls the clouds sideways; the hero also drifts while zooming in from the overview
        const shift = distance * .45 + (sky.index === 0 ? intro * .3 : 0);
        // only the lap copy being looked at; when that copy changes (lap seam) it is painted at once, otherwise it
        // would show the frame it got a whole lap ago
        const lap = Math.round((position - distance - sky.index) / count);
        const slot = lap - lastCycle + 1;
        if (slot === sky.slot && !pointerMoving && Math.abs(shift - sky.shift) <= .0005 && skyClock - sky.painted < 1 / 15) return;
        sky.painted = skyClock;
        sky.shift = shift;
        sky.slot = slot;
        paintSky(skyClock + sky.offset, pointer.x, pointer.y, scale, shift, [slot], sky.palette, sky.contexts);
      });
    };

    // Anchor buttons: the camera pulls back so start and target are both in view, glides across and zooms into the
    // target screen. Only the camera moves; the route position jumps to the target when the flight ends.
    let flying = false;
    const flight = { from: 0, to: 0, t: 0 };
    const flyTo = (value: number) => {
      flight.from = position;
      flight.to = value;
      flight.t = 0;
      const target = pointAt(value);
      const scaleNow = Number(gsap.getProperty(camera, 'scale'));
      cam.scale = scaleNow;
      cam.cx = (window.innerWidth / 2 - Number(gsap.getProperty(camera, 'x'))) / scaleNow;
      cam.cy = (window.innerHeight / 2 - Number(gsap.getProperty(camera, 'y'))) / scaleNow;
      const far = Math.min(
        .42,
        scaleNow,
        window.innerWidth / (Math.abs(target.x - cam.cx) + screenWidth * 1.3),
        window.innerHeight / (Math.abs(target.y - cam.cy) + screenHeight * 1.3),
      );
      const slow = reduced.matches ? .4 : 1;
      flying = true;
      gsap.timeline({
        onComplete: () => {
          position = value;
          positionTarget = value;
          intro = 1;
          introTarget = 1;
          flying = false;
        },
      })
        .to(cam, { scale: far, duration: .8 * slow, ease: 'power2.inOut' }, 0)
        .to(cam, { cx: target.x, cy: target.y, duration: 1.3 * slow, ease: 'power2.inOut' }, .3 * slow)
        .to(flight, { t: 1, duration: 1.3 * slow, ease: 'power2.inOut' }, .3 * slow)
        .to(cam, { scale: 1, duration: .9 * slow, ease: 'power2.inOut' }, 1.05 * slow);
    };

    gsap.ticker.add(() => {
      if (!ready) return;
      if (flying) {
        // the route position follows the flight, so the laps and the skies under the camera stay current
        position = mix(flight.from, flight.to, flight.t);
        positionTarget = position;
        layoutCycles(Math.floor(position / count));
        applyCamera();
        return;
      }
      if (detailOpen) {
        if (detailFree) {
          const easing = reduced.matches ? 1 : .11;
          detailPos += (detailTarget - detailPos) * easing;
          intro += (introTarget - intro) * easing;
          const index = Math.floor(detailPos);
          const from = stopAt(index);
          const to = stopAt(index + 1);
          const amount = smooth(detailPos - index);
          const zoom = smooth(intro);
          const { overviewX, overviewY, overviewScale } = view();
          cam.cx = mix(overviewX, mix(from.x, to.x, amount), zoom);
          cam.cy = mix(overviewY, mix(from.y, to.y, amount), zoom);
          cam.scale = mix(overviewScale, 1, zoom);
          // keep the route position in step with the path (sky, laps) and re-lay the laps out when we cross one
          position = mix(from.value, to.value, amount);
          positionTarget = position;
          const lap = lastCycle;
          layoutCycles(Math.floor(position / count));
          if (lastCycle !== lap) syncPush();
        }
        applyCamera();
        return;
      }
      const easing = reduced.matches ? 1 : .11;
      intro += (introTarget - intro) * easing;
      position += (positionTarget - position) * easing;
      if (Math.abs(introTarget - intro) < 1e-4) intro = introTarget;
      if (Math.abs(positionTarget - position) < 1e-4) position = positionTarget;

      const route = pointAt(position);
      layoutCycles(route.cycle);

      const { overviewX, overviewY, overviewScale, focusedScale } = view();
      const zoom = smooth(intro);
      const x = mix(overviewX, route.x, zoom);
      const y = mix(overviewY, route.y, zoom);
      const scale = mix(overviewScale, focusedScale, zoom);

      writeCamera(window.innerWidth / 2 - x * scale, window.innerHeight / 2 - y * scale, scale);
      const entered = intro > .04 || position > .01;
      if (entered !== root.classList.contains('has-entered')) root.classList.toggle('has-entered', entered);
    });

    gsap.ticker.add(tickSky);
  }
</script>

<style define:vars={{ sectionWidth, sectionHeight }}>
  .experience,
  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 12% 8%, rgba(255, 255, 255, .6), transparent 70%),
      radial-gradient(50% 60% at 92% 88%, rgba(176, 156, 238, .3), transparent 70%),
      radial-gradient(42% 42% at 82% 14%, rgba(255, 178, 204, .26), transparent 70%),
      radial-gradient(rgba(28, 44, 78, .13) 1px, transparent 1.5px) 0 0 / 30px 30px,
      #c4d8ec;
  }

  /* phones: the dot grid reads as noise at this size, so only the soft color fields stay */
  @media (max-width: 700px) {
    .experience,
    .viewport {
      background:
        radial-gradient(60% 55% at 12% 8%, rgba(255, 255, 255, .6), transparent 70%),
        radial-gradient(50% 60% at 92% 88%, rgba(176, 156, 238, .3), transparent 70%),
        radial-gradient(42% 42% at 82% 14%, rgba(255, 178, 204, .26), transparent 70%),
        #c4d8ec;
    }
  }

  .experience {
    outline: none;
    touch-action: none;
  }

  .camera,
  .cycle {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
  }

  .camera { will-change: transform; }

  .camera {
    z-index: 1;
    opacity: 0;
    transition: opacity .9s ease;
  }

  .experience.is-staged .camera { opacity: 1; }

  .screen {
    position: absolute;
    display: flex;
    width: calc(var(--sectionWidth) * 1px);
    height: calc(var(--sectionHeight) * 1px);
    flex-direction: column;
    padding: 0;
    color: var(--ink, #111);
    background: var(--flash-color, var(--color));
    transition: background-color .08s linear;
  }

  .screen > * { transition: opacity .45s ease; }
  .experience.is-loading .screen > * { opacity: 0; }

  /* light mode (phones): no permanent camera layer and no per-element fades (each fade is its own layer) */
  .experience.is-light .camera { will-change: auto; transition: none; }
  .experience.is-light .screen > * { transition: none; }
  .experience.is-light.is-loading .screen > * { opacity: 0; visibility: hidden; }

  /* Hero: sizes come from the 1600px Figma frame, scaled with the screen width (1cqw = 16px in Figma) */
  .screen[data-screen='0'] {
    container-type: inline-size;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    padding: 0;
    background: linear-gradient(112deg, #b8dcf2 0%, #e8f3fa 48%, #faf2ed 100%);
  }

  .screen .hero__title {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 0 3cqw;
    letter-spacing: 0;
    color: #000;
    font-family: 'DM Sans', sans-serif;
    font-size: 10cqw;
    font-variation-settings: 'opsz' 14;
    font-weight: 600;
    line-height: normal;
    text-align: center;
    text-box: trim-both cap alphabetic;
  }

  .hero__box {
    position: absolute;
    z-index: 1;
    bottom: 3cqw;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2cqw;
    width: 59.6cqw;
    padding: 1.5cqw 2cqw;
    background: rgba(255, 255, 255, .45);
    border-radius: 1.25cqw;
    transform: translateX(-50%);
  }

  .hero__text {
    margin: 0;
    color: rgba(0, 0, 0, .7);
    font-family: Inter, Arial, sans-serif;
    font-size: max(12px, 1.25cqw);
    font-weight: 400;
    line-height: normal;
    text-align: center;
    text-box: trim-both cap alphabetic;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: .625cqw;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.3cqw;
    padding: .75cqw 1cqw;
    border: 0;
    border-radius: 1.25cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: max(11px, .75cqw);
    font-weight: 500;
    line-height: normal;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .hero__button--light { color: #000; background: #fff; }
  .hero__button--dark { color: #fff; background: rgba(0, 0, 0, .3); }

  @container (max-width: 700px) {
    .screen .hero__title { font-size: 17cqw; }
    .hero__box { width: calc(100% - 6cqw); padding: 20px; gap: 20px; border-radius: 16px; }
    .hero__text { font-size: 14px; }
    .hero__button { padding: 10px 16px; font-size: 12px; border-radius: 16px; }
  }

  /* Closing contact screen: big type over the same cloud shader as the hero, in lilac / peach */
  .experience .screen.screen--contact[data-screen] {
    display: block;
    padding: 0;
    overflow: hidden;
    background: var(--flash-color, linear-gradient(112deg, #c2d1f5 0%, #e9e4f8 48%, #faf1ef 100%));
    --ink-rgb: 28 23 18;
  }

  /* Skills & more works: one flat-colored screen, four skill cards on top and four extra projects below */
  .experience .screen.screen--skills[data-screen] {
    display: block;
    padding: 0;
    overflow: hidden;
    background: var(--flash-color, var(--color));
    --ink-rgb: 28 23 18;
  }

  /* phones: the skill cards are as tall as their content and the works follow right below them (a container query
     cannot style the screen itself, so this one is a media query on the same 700px breakpoint as the script) */
  @media (max-width: 700px) {
    .experience .screen.screen--skills[data-screen] { display: flex; flex-direction: column; gap: 3cqh; padding: 3cqh 4cqw; }
  }

  /* more works on the left, skills on the right (2 x 2), both from the top */
  .skills__grid {
    position: absolute;
    z-index: 1;
    top: 7cqh;
    bottom: 7cqh;
    right: 4cqw;
    width: 44cqw;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1.2cqw;
  }

  .skills__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.6cqh;
    min-height: 0;
    padding: 1.7cqw 1.8cqw;
    overflow: hidden;
    background: rgba(255, 255, 255, .45);
    border-radius: 1.1cqw;
  }

  .skills__heading {
    margin: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: min(1.5cqw, 2.8cqh);
    font-weight: 500;
    line-height: 1.15;
    color: rgb(var(--ink-rgb) / 1);
  }

  .skills__list { display: flex; flex-direction: column; gap: .75cqh; margin: 0; padding: 0; list-style: none; }

  .skills__list li {
    display: flex;
    align-items: center;
    gap: .5cqw;
    min-width: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: max(9px, min(.82cqw, 1.55cqh));
    font-weight: 300;
    line-height: 1.25;
    color: rgb(var(--ink-rgb) / .8);
  }

  .skills__list svg { flex: none; width: max(9px, .85cqw); height: auto; color: rgb(var(--ink-rgb) / .7); }

  .works {
    position: absolute;
    z-index: 1;
    top: 7cqh;
    left: 4cqw;
    bottom: 7cqh;
    width: 44cqw;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 2.4cqh;
  }

  .works__label {
    margin: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: max(10px, min(.95cqw, 1.7cqh));
