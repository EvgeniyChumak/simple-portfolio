---
const sectionWidth = 1280;
const sectionHeight = 720;
const cycleX = sectionWidth * 3;
const cycleY = sectionHeight * 3;

const sections = [
  {
    eyebrow: 'Webflow developer · Europe',
    title: ['Hello, I`m Yevhen'],
    text: 'I’m a developer with almost 4 years of experience and more than 50 completed projects, building large, complex websites across frontend development and Webflow, with API integrations, GSAP animations and performance optimization.',
    color: '#d9ff43',
    x: 0,
    y: 0,
  },
  {
    eyebrow: '01 · Selected project',
    title: ['GOTARIS'],
    text: 'Subscription crypto analysis with authentication, payments, dashboards and a scalable archive.',
    color: '#8ea8ff',
    x: sectionWidth,
    y: 0,
    href: 'https://www.gotaris.de/',
  },
  {
    eyebrow: '02 · Selected project',
    title: ['reLounge'],
    text: 'A multilingual medical platform with structured CMS content and custom proximity search.',
    color: '#ffb64d',
    x: sectionWidth,
    y: sectionHeight,
    href: 'https://www.reloungeclub.com/en',
  },
  {
    eyebrow: '03 · Selected project',
    title: ['Marketer UX'],
    text: 'Long-term technical ownership across redesign, motion, forms, SEO and performance.',
    color: '#e69aff',
    x: sectionWidth * 2,
    y: sectionHeight,
    href: 'https://www.marketer-ux.com/',
  },
  {
    eyebrow: '04 · Services',
    title: ['Build.', 'Connect. Refine.'],
    text: 'Webflow · CMS architecture · JavaScript · integrations · performance · technical SEO.',
    color: '#77dfc1',
    x: sectionWidth * 2,
    y: sectionHeight * 2,
  },
  {
    eyebrow: '05 · Contact',
    title: ['Let’s make', 'it work.'],
    text: 'Available for selected freelance projects and long-term collaborations.',
    color: '#f2eee4',
    x: sectionWidth * 3,
    y: sectionHeight * 2,
    href: 'mailto:gekachumak@gmail.com',
    linkLabel: 'Email me ↗',
  },
];


const groupSlots = [-1, 0, 1, 2];
---

<div
  class="experience"
  data-experience
  data-count={sections.length}
  data-cycle-x={cycleX}
  data-cycle-y={cycleY}
  tabindex="0"
>
  <div class="viewport">
    <div class="camera" data-camera>
      {groupSlots.map((slot) => (
        <div class="cycle" data-cycle data-slot={slot}>
          {sections.map((section, index) => (
            <section
              class="screen"
              data-screen={index}
              style={`left:${section.x}px;top:${section.y}px;--color:${section.color}`}
            >
              {index === 0 ? (
                <>
                  <canvas class="sky" data-sky aria-hidden="true"></canvas>
                  <h2 class="hero__title">{section.title[0]}</h2>
                  <p class="hero__box">{section.text}</p>
                </>
              ) : (
                <>
                  <p class="eyebrow">{section.eyebrow}</p>
                  <div class="screen__main">
                    <h2>{section.title.map((line) => <span>{line}</span>)}</h2>
                    <p>{section.text}</p>
                  </div>
                  <footer>
                    <span>{String(index + 1).padStart(2, '0')} / {String(sections.length).padStart(2, '0')}</span>
                    {section.href && (
                      <a href={section.href} target={section.href.startsWith('mailto:') ? undefined : '_blank'} rel="noreferrer">
                        {section.linkLabel ?? 'View project ↗'}
                      </a>
                    )}
                  </footer>
                </>
              )}
            </section>
          ))}
        </div>
      ))}
    </div>
    <div class="scroll-cue" aria-hidden="true">
      <svg viewBox="0 0 40 56" role="img">
        <rect x="1" y="1" width="38" height="54" rx="19"></rect>
        <path d="M20 13v22m-7-7 7 7 7-7"></path>
      </svg>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { skyFragment, skyScaleFar, skyScaleNear, skyVertex } from './skyShader';

  const root = document.querySelector<HTMLElement>('[data-experience]');
  const camera = root?.querySelector<HTMLElement>('[data-camera]');

  if (root && camera) {
    const count = Number(root.dataset.count ?? 6);
    let cycleX = Number(root.dataset.cycleX ?? 3840);
    let cycleY = Number(root.dataset.cycleY ?? 2160);
    const cycles = [...root.querySelectorAll<HTMLElement>('[data-cycle]')];
    const screens = [...root.querySelectorAll<HTMLElement>('[data-screen]')];
    // Ice palette
    const activePalette = ['#f3fbff', '#d6ecff', '#9dcdf4', '#5d99c6', '#d9f7ff', '#eef0ff'];
    let screenWidth = 1280;
    let screenHeight = 720;
    let points = [
      [640, 360],
      [1920, 360],
      [1920, 1080],
      [3200, 1080],
      [3200, 1800],
      [4480, 1800],
    ];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let introTarget = 0;
    let intro = 0;
    let positionTarget = 0;
    let position = 0;
    let lastCycle = Number.NaN;
    let touchY = 0;
    let ready = false;
    let flickerTimer: number | undefined;
    let preloaderTimeline: gsap.core.Timeline | null = null;

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const smooth = (value: number) => value * value * (3 - 2 * value);
    const modulo = (value: number, divisor: number) => ((value % divisor) + divisor) % divisor;
    const mix = (from: number, to: number, amount: number) => from + (to - from) * amount;

    const layoutGeometry = () => {
      const desktop = window.innerWidth > 700;
      screenWidth = Math.max(320, desktop ? window.innerWidth * .95 : window.innerWidth - 16);
      screenHeight = Math.max(320, window.innerHeight);
      cycleX = screenWidth * 3;
      cycleY = screenHeight * 3;
      points = [
        [screenWidth * .5, screenHeight * .5],
        [screenWidth * 1.5, screenHeight * .5],
        [screenWidth * 1.5, screenHeight * 1.5],
        [screenWidth * 2.5, screenHeight * 1.5],
        [screenWidth * 2.5, screenHeight * 2.5],
        [screenWidth * 3.5, screenHeight * 2.5],
      ];

      const positions = [
        [0, 0],
        [screenWidth, 0],
        [screenWidth, screenHeight],
        [screenWidth * 2, screenHeight],
        [screenWidth * 2, screenHeight * 2],
        [screenWidth * 3, screenHeight * 2],
      ];

      screens.forEach((screen) => {
        const index = Number(screen.dataset.screen ?? 0);
        const position = positions[index] ?? positions[0];
        gsap.set(screen, {
          left: position[0],
          top: position[1],
          width: screenWidth,
          height: screenHeight,
        });
      });

      lastCycle = Number.NaN;
      layoutCycles(Math.floor(position / count));
    };

    const inkFor = (hex: string) => {
      const value = hex.replace('#', '');
      const red = Number.parseInt(value.slice(0, 2), 16);
      const green = Number.parseInt(value.slice(2, 4), 16);
      const blue = Number.parseInt(value.slice(4, 6), 16);
      const luminance = (red * .299 + green * .587 + blue * .114) / 255;
      return luminance > .56 ? '#111111' : '#f7f4ec';
    };

    const applyPalette = () => {
      screens.forEach((screen) => {
        const screenIndex = Number(screen.dataset.screen ?? 0);
        const color = activePalette[screenIndex % activePalette.length] ?? activePalette[0];
        screen.style.setProperty('--color', color);
        screen.style.setProperty('--ink', inkFor(color));
      });
    };

    applyPalette();

    const view = () => ({
      overviewX: points[0][0],
      overviewY: points[0][1],
      overviewScale: Math.min(
        (window.innerWidth / 2 - 24) / (cycleX + screenWidth * .5),
        (window.innerHeight / 2 - 24) / (cycleY - screenHeight * .5),
      ),
      focusedScale: 1,
    });

    const setOverviewCamera = () => {
      const { overviewX, overviewY, overviewScale } = view();
      gsap.set(camera, {
        x: window.innerWidth / 2 - overviewX * overviewScale,
        y: window.innerHeight / 2 - overviewY * overviewScale,
        scale: overviewScale,
        transformOrigin: '0 0',
      });
    };

    const pointAt = (value: number) => {
      const cycle = Math.floor(value / count);
      const local = modulo(value, count);
      const index = Math.floor(local);
      const amount = smooth(local - index);
      const current = points[index] ?? points[0];
      const next = index === count - 1 ? points[0] : points[index + 1];
      const nextCycle = index === count - 1 ? cycle + 1 : cycle;

      return {
        cycle,
        x: mix(current[0] + cycle * cycleX, next[0] + nextCycle * cycleX, amount),
        y: mix(current[1] + cycle * cycleY, next[1] + nextCycle * cycleY, amount),
      };
    };

    const layoutCycles = (centerCycle: number) => {
      if (centerCycle === lastCycle) return;
      lastCycle = centerCycle;
      cycles.forEach((cycleElement) => {
        const slot = Number(cycleElement.dataset.slot ?? 0);
        const cycleIndex = centerCycle + slot;
        gsap.set(cycleElement, { x: cycleIndex * cycleX, y: cycleIndex * cycleY });
      });
    };

    layoutGeometry();
    root.classList.add('is-loading');
    setOverviewCamera();
    // Reveal only after the camera sits in the overview, so the unscaled first paint is never visible.
    requestAnimationFrame(() => root.classList.add('is-staged'));
    window.addEventListener('resize', layoutGeometry, { passive: true });

    const addMovement = (delta: number) => {
      if (!ready) return;
      if (introTarget < 1 && delta > 0) {
        introTarget = clamp(introTarget + delta * .0017, 0, 1);
        return;
      }
      if (introTarget > 0 && delta < 0 && positionTarget <= .001) {
        introTarget = clamp(introTarget + delta * .0017, 0, 1);
        return;
      }
      positionTarget = Math.max(0, positionTarget + delta * .00088);
    };

    root.addEventListener('wheel', (event) => {
      event.preventDefault();
      addMovement(event.deltaY);
    }, { passive: false });

    root.addEventListener('touchstart', (event) => {
      touchY = event.touches[0]?.clientY ?? 0;
    }, { passive: true });

    root.addEventListener('touchmove', (event) => {
      const nextY = event.touches[0]?.clientY ?? touchY;
      const delta = touchY - nextY;
      touchY = nextY;
      event.preventDefault();
      addMovement(delta * 2.2);
    }, { passive: false });

    root.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].includes(event.key)) {
        event.preventDefault();
        addMovement(220);
      }
      if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        addMovement(-220);
      }
    });

    const startPreloader = () => {
      preloaderTimeline?.kill();
      if (flickerTimer !== undefined) window.clearInterval(flickerTimer);

      introTarget = 0;
      intro = 0;
      positionTarget = 0;
      position = 0;
      lastCycle = Number.NaN;
      ready = false;
      root.classList.remove('is-ready', 'has-entered');

      const { overviewX, overviewY, overviewScale } = view();
      const baseX = window.innerWidth / 2 - overviewX * overviewScale;
      const baseY = window.innerHeight / 2 - overviewY * overviewScale;
      const nextCycleX = baseX - cycleX * overviewScale;
      const nextCycleY = baseY - cycleY * overviewScale;
      let colorStep = 0;

      root.classList.add('is-loading');
      layoutCycles(0);
      gsap.set(camera, { x: baseX, y: baseY, scale: overviewScale, transformOrigin: '0 0' });

      flickerTimer = window.setInterval(() => {
        colorStep += 1;
        screens.forEach((screen, index) => {
          screen.style.setProperty('--flash-color', activePalette[(index + colorStep) % activePalette.length] ?? activePalette[0]);
        });
      }, reduced.matches ? 240 : 95);

      preloaderTimeline = gsap.timeline({
        onComplete: () => {
          if (flickerTimer !== undefined) window.clearInterval(flickerTimer);
          flickerTimer = undefined;
          preloaderTimeline = null;
          screens.forEach((screen) => screen.style.removeProperty('--flash-color'));
          gsap.set(camera, { x: baseX, y: baseY, scale: overviewScale });
          root.classList.remove('is-loading');
          root.classList.add('is-ready');
          ready = true;
          root.focus({ preventScroll: true });
        },
      })
        .to(camera, {
          x: nextCycleX,
          y: nextCycleY,
          duration: reduced.matches ? .8 : 3.2,
          ease: 'none',
        });
    };

    if (document.readyState === 'complete') startPreloader();
    else window.addEventListener('load', startPreloader, { once: true });

    // Hero sky: one shared WebGL cloud shader, copied only into the hero canvases that are on screen.
    const skyWidth = 640;
    const skyHeight = 360;
    const skyCanvases = [...root.querySelectorAll<HTMLCanvasElement>('[data-sky]')];
    const skyContexts = skyCanvases.map((canvas) => {
      canvas.width = skyWidth;
      canvas.height = skyHeight;
      return canvas.getContext('2d');
    });
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    window.addEventListener('pointermove', (event) => {
      pointer.tx = event.clientX / window.innerWidth - .5;
      pointer.ty = .5 - event.clientY / window.innerHeight;
    }, { passive: true });

    const createSky = () => {
      const canvas = document.createElement('canvas');
      canvas.width = skyWidth;
      canvas.height = skyHeight;
      const gl = canvas.getContext('webgl', { antialias: false, depth: false, stencil: false });
      if (!gl) return null;
      const compile = (type: number, source: string) => {
        const shader = gl.createShader(type)!;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return shader;
      };
      const program = gl.createProgram()!;
      gl.attachShader(program, compile(gl.VERTEX_SHADER, skyVertex));
      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, skyFragment));
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return null;
      gl.useProgram(program);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'aPos');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(gl.getUniformLocation(program, 'uRes'), canvas.width, canvas.height);
      const uTime = gl.getUniformLocation(program, 'uTime');
      const uMouse = gl.getUniformLocation(program, 'uMouse');
      const uScale = gl.getUniformLocation(program, 'uScale');
      return (time: number, x: number, y: number, scale: number, targets: number[]) => {
        gl.uniform1f(uTime, time);
        gl.uniform2f(uMouse, x, y);
        gl.uniform1f(uScale, scale);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        targets.forEach((index) => skyContexts[index]?.drawImage(canvas, 0, 0));
      };
    };
    const drawSky = createSky();

    // Canvas slots follow the cycle layout: [previous, current, next, +2]. The hero of the current
    // cycle is on screen at the start of a lap, the next cycle's hero at the end of it.
    const visibleSkies = () => {
      if (!ready || (intro < .04 && position < .01)) return skyCanvases.map((_, index) => index);
      const local = modulo(position, count);
      const targets: number[] = [];
      if (local < .75) targets.push(1);
      if (local > count - .75) targets.push(2);
      return targets;
    };

    gsap.ticker.add((time) => {
      pointer.x += (pointer.tx - pointer.x) * .06;
      pointer.y += (pointer.ty - pointer.y) * .06;
      // Skip hidden tabs and frames where no hero is visible
      if (!drawSky || document.hidden) return;
      const targets = visibleSkies();
      if (!targets.length) return;
      // clouds zoom with the camera: far away from the start, a bit closer once inside the hero
      drawSky(time + 20, pointer.x, pointer.y, mix(skyScaleFar, skyScaleNear, smooth(intro)), targets);
    });

    gsap.ticker.add(() => {
      if (!ready) return;
      const easing = reduced.matches ? 1 : .11;
      intro += (introTarget - intro) * easing;
      position += (positionTarget - position) * easing;

      const route = pointAt(position);
      layoutCycles(route.cycle);

      const { overviewX, overviewY, overviewScale, focusedScale } = view();
      const zoom = smooth(intro);
      const x = mix(overviewX, route.x, zoom);
      const y = mix(overviewY, route.y, zoom);
      const scale = mix(overviewScale, focusedScale, zoom);

      gsap.set(camera, {
        x: window.innerWidth / 2 - x * scale,
        y: window.innerHeight / 2 - y * scale,
        scale,
        transformOrigin: '0 0',
      });
      root.classList.toggle('has-entered', intro > .04 || position > .01);
    });
  }
</script>

<style define:vars={{ sectionWidth, sectionHeight }}>
  .experience,
  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #0b0b0b;
  }

  .experience {
    outline: none;
    touch-action: none;
  }

  .camera,
  .cycle {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    will-change: transform;
  }

  .camera {
    z-index: 1;
    opacity: 0;
    transition: opacity .9s ease;
  }

  .experience.is-staged .camera { opacity: 1; }

  .screen {
    position: absolute;
    display: flex;
    width: calc(var(--sectionWidth) * 1px);
    height: calc(var(--sectionHeight) * 1px);
    flex-direction: column;
    justify-content: space-between;
    padding: 56px 70px 48px;
    color: var(--ink, #111);
    background: var(--flash-color, var(--color));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 18%, transparent);
    transition: background-color .08s linear;
  }

  .screen > .eyebrow,
  .screen > .screen__main,
  .screen > footer { position: relative; z-index: 1; }

  .screen > * { transition: opacity .45s ease; }
  .experience.is-loading .screen > * { opacity: 0; }

  /* Hero: sizes come from the 1600px Figma frame, scaled with the screen width (1cqw = 16px in Figma) */
  .screen[data-screen='0'] {
    container-type: inline-size;
    justify-content: center;
    align-items: center;
    padding: 0;
    background: linear-gradient(112deg, #b8dcf2 0%, #e8f3fa 48%, #faf2ed 100%);
  }

  .screen .hero__title {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 0 3cqw;
    letter-spacing: 0;
    color: #000;
    font-family: 'DM Sans', sans-serif;
    font-size: 10cqw;
    font-variation-settings: 'opsz' 14;
    font-weight: 600;
    line-height: normal;
    text-align: center;
    text-box: trim-both cap alphabetic;
  }

  .hero__box {
    position: absolute;
    z-index: 1;
    bottom: 3cqw;
    left: 50%;
    width: 59.6cqw;
    margin: 0;
    padding: 2cqw;
    color: rgba(0, 0, 0, .7);
    background: rgba(255, 255, 255, .4);
    border-radius: 1.5cqw;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    font-family: Inter, Arial, sans-serif;
    font-size: max(12px, 1.25cqw);
    font-weight: 400;
    line-height: normal;
    text-align: center;
    text-box: trim-both cap alphabetic;
    transform: translateX(-50%);
  }

  @container (max-width: 700px) {
    .screen .hero__title { font-size: 17cqw; }
    .hero__box { width: calc(100% - 6cqw); padding: 20px; font-size: 14px; }
  }

  .experience.is-loading .screen[data-screen='0'] {
    background: var(--flash-color, var(--color));
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: opacity .6s ease;
  }

  .experience.is-loading .sky { opacity: 0; }

  .scroll-cue {
    position: fixed;
    z-index: 10;
    bottom: 1.5rem;
    left: 50%;
    width: 2.5rem;
    height: 3.5rem;
    opacity: 0;
    color: #f4f1e8;
    transform: translate(-50%, .75rem);
    transition: opacity .4s ease, transform .4s ease;
    pointer-events: none;
  }

  .experience.is-ready:not(.has-entered) .scroll-cue {
    opacity: 1;
    transform: translate(-50%, 0);
    animation: cue-bob 1.25s ease-in-out infinite;
  }

  .scroll-cue svg { display: block; width: 100%; height: 100%; }
  .scroll-cue rect, .scroll-cue path { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .scroll-cue path { stroke-linecap: round; stroke-linejoin: round; }

  @keyframes cue-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 .35rem; }
  }

  .eyebrow,
  .screen footer {
    margin: 0;
    font-size: 14px;
    font-weight: 750;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .screen__main {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, .62fr);
    align-items: end;
    gap: 54px;
  }

  .screen h2 {
    margin: 0;
    font-size: 112px;
    font-weight: 650;
    line-height: .84;
    letter-spacing: -.075em;
  }

  .screen h2 span { display: block; }
  .screen__main > p { margin: 0; font-size: 20px; line-height: 1.45; }

  .screen footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, currentColor 32%, transparent);
  }

  .screen footer a { color: inherit; text-decoration: none; }

  @media (max-width: 700px) {
    .screen { padding: 70px 90px; }
    .screen__main { grid-template-columns: 1fr; gap: 36px; }
    .screen h2 { font-size: 100px; }
    .screen__main > p { max-width: 700px; font-size: 26px; }
    .eyebrow, .screen footer { font-size: 17px; }
  }

</style>
