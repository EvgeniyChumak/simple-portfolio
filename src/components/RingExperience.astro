  }

  @container (max-width: 700px) {
    .skills__grid { position: static; width: auto; height: auto; grid-template-rows: none; gap: 2cqw; }
    .skills__card { justify-content: flex-start; padding: 3.5cqw; border-radius: 3cqw; gap: 10px; }
