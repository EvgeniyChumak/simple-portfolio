  .contact__title span { display: block; }
  .contact__title b { display: inline-block; font-weight: inherit; transition: transform .6s cubic-bezier(.22, 1, .36, 1), color .4s ease; }
  /* the second line is only an outline: it fills in when the pointer touches a word */
  .contact__title span:last-child b { color: transparent; -webkit-text-stroke: 1.2px rgb(var(--ink-rgb) / 1); }
  .contact__title span:last-child b:hover { color: rgb(var(--ink-rgb) / 1); }
  .contact__title b:hover { transform: translateY(-.04em) skewX(-4deg); }
  .contact__title b + b { margin-left: .24em; }

  .contact__side { position: absolute; z-index: 1; top: 26cqh; right: 4cqw; width: 36cqw; }

  .contact__intro { margin: 0 0 3cqh; font-family: Inter, Arial, sans-serif; font-size: max(11px, min(1.35cqw, 2.4cqh)); line-height: 1.5; color: rgb(var(--ink-rgb) / .75); }
  .contact__intro span { display: block; }
  .contact__intro em { display: block; margin-top: .8cqh; font-style: normal; color: rgb(var(--ink-rgb) / 1); font-weight: 500; }

  .contact__links { display: flex; flex-direction: column; border-bottom: 1px solid rgb(var(--ink-rgb) / .22); }

  .contact__link {
    position: relative;
    display: grid;
    grid-template-columns: 9cqw minmax(0, 1fr) auto;
    align-items: center;
    padding: 1.15cqw 1cqw;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid rgb(var(--ink-rgb) / .22);
    color: rgb(var(--ink-rgb) / 1);
    text-decoration: none;
    transition: color .4s ease, padding .5s cubic-bezier(.22, 1, .36, 1);
  }

  .contact__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--ink-rgb) / 1);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  .contact__link:hover, .contact__link:focus-visible { padding-left: 2cqw; color: #f4faff; }
  .contact__link:hover::before, .contact__link:focus-visible::before { transform: scaleX(1); }
  .contact__link:focus-visible { outline: none; }

  .contact__label { font-family: Inter, Arial, sans-serif; font-size: max(9px, min(.95cqw, 1.7cqh)); letter-spacing: .14em; text-transform: uppercase; opacity: .65; }
  .contact__value { font-family: 'DM Sans', Inter, sans-serif; font-size: min(1.9cqw, 3.4cqh); font-weight: 600; line-height: 1.1; overflow-wrap: anywhere; }
  .contact__arrow { display: block; width: 1.3cqw; min-width: 10px; transition: transform .5s cubic-bezier(.22, 1, .36, 1); }
  .contact__arrow svg { display: block; width: 100%; height: auto; }
  .contact__link:hover .contact__arrow, .contact__link:focus-visible .contact__arrow { transform: translateX(.4cqw) rotate(-45deg); }

  .contact__foot {
    position: absolute;
    z-index: 1;
    right: 4cqw;
    bottom: 5cqh;
    left: 4cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: Inter, Arial, sans-serif;
    font-size: max(10px, min(1cqw, 1.8cqh));
    color: rgb(var(--ink-rgb) / .65);
  }

  .contact__foot p { margin: 0; }


  @container (max-width: 700px) {
    .contact__title { top: 11cqh; left: 6cqw; font-size: 17cqw; }
    .contact__side { top: 40cqh; right: 6cqw; left: 6cqw; width: auto; }
    .contact__top { right: 6cqw; left: 6cqw; }
    .contact__foot { right: 6cqw; left: 6cqw; }
    .contact__link { grid-template-columns: 22cqw minmax(0, 1fr) auto; padding: 3cqw 2cqw; }
    .contact__value { font-size: 4.4cqw; }
    .contact__label { font-size: 10px; }
    .contact__intro { font-size: 12px; }
  }

  /* Cases: sizes come from a 700x443 layout, scaled with the screen (cqw = width, cqh = height) */
  .screen:not([data-screen='0']) {
    container-type: size;
    background: var(--flash-color, linear-gradient(135deg, var(--color), color-mix(in srgb, var(--color) 55%, white)));
    color: rgb(var(--ink-rgb) / 1);
    --ink-rgb: 28 23 18;
    --card-bg: rgba(255, 255, 255, .4);
    --chip-bg: rgba(255, 255, 255, .65);
  }

  /* dark backgrounds (e.g. Marketer UX): white text, softer glass */
  .screen[data-tone='dark']:not([data-screen='0']) {
    --ink-rgb: 255 255 255;
    --card-bg: rgba(255, 255, 255, .14);
    --chip-bg: rgba(255, 255, 255, .18);
  }

  .case__title {
    position: absolute;
    z-index: 1;
    top: 4.8cqh;
    left: 4cqw;
    width: 16em; /* wraps after "... Analysis" on desktop; em follows the title font size */
    max-width: 90cqw;
    margin: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: min(4.4cqw, 6.8cqh);
    font-variation-settings: 'opsz' 14;
    font-weight: 500;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .case__gallery {
    position: absolute;
    z-index: 1;
    top: 25cqh;
    bottom: 4cqh;
    left: 4cqw;
    right: 4cqw;
    display: grid;
    /* the image column follows the available height; the picture keeps a landscape ratio and the card matches it */
    grid-template-columns: min(54cqw, 76cqh) minmax(0, 1fr);
    grid-template-rows: auto;
    align-content: center;
    column-gap: 3cqw;
  }

  .case__slider { display: flex; min-width: 0; flex-direction: column; gap: .9cqw; }

  .case__stage { position: relative; aspect-ratio: 1.35; overflow: hidden; cursor: pointer; background: rgba(255, 255, 255, .4); border-radius: 2cqw; }

  .case__stage > img { user-select: none; -webkit-user-drag: none; position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }

  .case__arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 2.6cqw;
    height: 2.6cqw;
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    place-items: center;
    color: #000;
    background: #fff;
    border: 0;
    border-radius: 50%;
    z-index: 2;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color .25s ease, transform .25s ease;
  }

  .case__arrow:hover { background: #d4d4d4; }
  .case__arrow--prev { left: .9cqw; }
  .case__arrow--next { right: .9cqw; }
  .case__arrow:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .case__arrow svg { display: block; width: 40%; height: auto; }
  .case__arrow--prev svg { transform: scaleX(-1); }

  .case__thumbs { display: flex; flex: none; gap: .7cqw; }

  .case__thumb {
    flex: 0 0 calc((100% - 2.8cqw) / 5); /* same size whatever the number of pictures */
    min-width: 0;
    aspect-ratio: 3 / 2;
    padding: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, .2);
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: .4cqw;
    cursor: pointer;
    opacity: .78;
    outline: 1px solid transparent;
    outline-offset: 2px;
    transition: opacity .25s ease, outline-color .25s ease;
  }

  .case__thumb:hover { opacity: .92; }
  .case__thumb.is-active { opacity: 1; outline-color: rgb(var(--ink-rgb) / .45); }
  .case__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .case__card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    justify-content: space-between;
    gap: 1cqw;
    padding: 1.6cqw;
    overflow: hidden;
    background: var(--card-bg);
    border-radius: 2cqw;
  }

  .case__card p,
  .case__card ul { margin: 0; }

  .case__name {
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: max(13px, 1.95cqw);
    font-weight: 500;
    text-transform: uppercase;
  }

  .case__card .case__tags { display: flex; flex-wrap: wrap; gap: .5cqw; margin-top: .9cqw; padding: 0; list-style: none; }

  .case__tags li {
    padding: .4cqw 1cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: clamp(10px, 1.05cqw, 12px);
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / 1);
    background: var(--chip-bg);
    border-radius: 99px;
  }

  .case__label {
    font-family: Inter, Arial, sans-serif;
    font-size: max(10px, 1.15cqw);
    font-weight: 500;
    color: rgb(var(--ink-rgb) / 1);
  }

  .case__card .case__text {
    margin-top: .6cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: max(10px, .95cqw);
    font-weight: 300;
    line-height: 1.45;
    color: rgb(var(--ink-rgb) / .7);
  }

  .case__actions { display: flex; gap: .625cqw; margin-top: 1.1cqw; }

  .case__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.3cqw;
    padding: .75cqw 1cqw;
    border: 0;
    border-radius: 1.25cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: max(11px, .75cqw);
    font-weight: 500;
    line-height: normal;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .case__button--light { color: #000; background: #fff; }
  .case__button--dark { color: #fff; background: rgba(0, 0, 0, .3); }

  /* Detail sections: content sits in a container pressed to the left, a project picture and a big outlined number
     on the right. Colors come from --ink-rgb so they also work on the dark Marketer UX background. */
  .detail-screen {
    display: flex;
    flex-direction: column;
    padding: 4.8cqh 4cqw 3cqh;
    overflow: hidden;
  }

  .detail-screen::after {
    content: attr(data-num);
    position: absolute;
    right: 3cqw;
    bottom: -5cqh;
    z-index: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: 36cqh;
    font-weight: 500;
    line-height: 1;
    color: rgb(var(--ink-rgb) / .045);
    pointer-events: none;
  }

  .detail__head { position: relative; z-index: 2; display: flex; align-items: center; gap: 1.2cqw; }

  /* small tracked label: clearly below the lead text in the hierarchy */
  .detail__title {
    flex: 1;
    margin: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: max(10px, min(.95cqw, 1.7cqh));
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / .6);
  }

  .detail__count { margin-right: 1cqw; font-family: Inter, Arial, sans-serif; font-size: max(10px, .95cqw); letter-spacing: .08em; color: rgb(var(--ink-rgb) / .6); }

  .detail__close {
    flex: none;
    padding: .75cqw 1cqw;
    min-width: 6.3cqw;
    color: #000;
    background: #fff;
    border: 0;
    border-radius: 1.25cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: max(11px, .75cqw);
    font-weight: 500;
    cursor: pointer;
    transition: background-color .25s ease;
  }

  .detail__close:hover { background: #d4d4d4; }

  .detail__body { position: relative; z-index: 2; display: flex; flex: 1; min-height: 0; width: 56cqw; flex-direction: column; margin-top: 6cqh; overflow: hidden; }

  .detail__intro { display: flex; flex-direction: column; gap: 3.4cqh; margin-bottom: 3.4cqh; }

  .detail__lead {
    margin: 0;
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: min(2.9cqw, 5cqh);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.015em;
    color: rgb(var(--ink-rgb) / 1);
  }

  /* stat table: just hairlines and small numbers, no fill */
  .detail__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid rgb(var(--ink-rgb) / .18);
  }

  .detail__metrics div { min-width: 0; padding: 1.1cqh 0 1.2cqh; }
  .detail__metrics div:nth-child(n + 3) { border-top: 1px solid rgb(var(--ink-rgb) / .18); }
  .detail__metrics div:nth-child(even) { padding-left: 1.8cqw; border-left: 1px solid rgb(var(--ink-rgb) / .18); }

  .detail__metrics dt {
    font-family: 'DM Sans', Inter, sans-serif;
    font-size: min(1.7cqw, 3cqh);
    font-weight: 600;
    line-height: 1.1;
    overflow-wrap: anywhere;
    color: rgb(var(--ink-rgb) / 1);
  }

  .detail__metrics dd {
    margin: .3cqh 0 0;
    font-family: Inter, Arial, sans-serif;
    font-size: max(8px, min(.75cqw, 1.4cqh));
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / .6);
  }

  /* architecture diagram: two lanes (content on top, access below) joined by labelled arrows */
  .detail__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6cqw minmax(0, 1fr) 6cqw minmax(0, 1fr);
    grid-template-rows: auto 8cqh auto;
    margin: 4cqh 0 0;
  }

  .detail__node {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 15cqh;
    flex-direction: column;
    gap: .6cqh;
    padding: 1.3cqw;
    border: 1px solid rgb(var(--ink-rgb) / .3);
    border-radius: 1.4cqw;
  }

  .detail__node--auto { background: rgb(var(--ink-rgb) / .06); border-color: rgb(var(--ink-rgb) / .18); }
  .detail__node--human { border-style: dashed; border-color: rgb(var(--ink-rgb) / .55); }

  .detail__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: .35cqw;
    margin-bottom: .4cqh;
    padding: .2cqw .6cqw;
    border: 1px solid rgb(var(--ink-rgb) / .3);
    border-radius: 99px;
    font-family: Inter, Arial, sans-serif;
    font-size: max(8px, min(.75cqw, 1.4cqh));
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / .75);
  }

  .detail__badge svg { width: .95cqw; min-width: 8px; height: auto; fill: none; stroke: currentColor; stroke-width: 1.2; }

  .detail__node h3 { margin: 0; font-family: 'DM Sans', Inter, sans-serif; font-size: min(1.35cqw, 2.6cqh); font-weight: 600; line-height: 1.1; color: rgb(var(--ink-rgb) / 1); }

  .detail__node ul { display: flex; flex-direction: column; gap: .5cqh; margin: auto 0 0; padding: 0; list-style: none; }

  .detail__node li {
    font-family: Inter, Arial, sans-serif;
    font-size: max(9px, min(1cqw, 1.8cqh));
    line-height: 1.3;
    color: rgb(var(--ink-rgb) / .72);
  }

  .detail__link { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: .3cqh; min-width: 0; color: rgb(var(--ink-rgb) / .55); }
  .detail__label { font-family: Inter, Arial, sans-serif; font-size: max(8px, min(.75cqw, 1.4cqh)); letter-spacing: .12em; text-transform: uppercase; }

  .detail__line { display: flex; align-items: center; width: 100%; }
  .detail__line i { flex: 1; height: 1px; background: currentColor; }
  .detail__line svg { display: block; flex: none; width: .55cqw; min-width: 5px; height: auto; margin-left: -.5px; }

  .detail__link--down,
  .detail__link--up { flex-direction: row; }
  .detail__link--down .detail__line,
  .detail__link--up .detail__line { width: auto; height: 100%; flex-direction: column; }
  .detail__link--up .detail__line { flex-direction: column-reverse; }
  .detail__link--down .detail__line i,
  .detail__link--up .detail__line i { width: 1px; height: auto; }
  .detail__link--down .detail__line svg { width: .7cqw; min-width: 6px; margin: -.5px 0 0; }
  .detail__link--up .detail__line svg { width: .7cqw; min-width: 6px; margin: 0 0 -.5px; }

  .detail__rows { display: flex; flex-direction: column; }

  .detail__row {
    display: grid;
    grid-template-columns: 15cqw minmax(0, 1fr);
    column-gap: 2.5cqw;
    padding: 2.2cqh 0;
    border-top: 1px solid rgb(var(--ink-rgb) / .18);
  }

  .detail__row h3 { margin: 0; font-family: 'DM Sans', Inter, sans-serif; font-size: min(1.8cqw, 3.2cqh); font-weight: 500; line-height: 1.2; color: rgb(var(--ink-rgb) / 1); }

  .detail__row p {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    font-size: max(11px, min(1.3cqw, 2.35cqh));
    line-height: 1.5;
    color: rgb(var(--ink-rgb) / .78);
  }

  .detail__row p + p { margin-top: .9cqh; }

  .detail__chips { display: flex; flex-wrap: wrap; gap: .5cqw; margin: 1.4cqh 0 0; padding: 0; list-style: none; }

  .detail__chips li {
    padding: .35cqw .9cqw;
    font-family: Inter, Arial, sans-serif;
    font-size: max(9px, min(1cqw, 1.8cqh));
    font-weight: 500;
    color: rgb(var(--ink-rgb) / 1);
    background: var(--chip-bg);
    border-radius: 99px;
  }

  .detail__visual {
    position: absolute;
    top: 14cqh;
    right: 4cqw;
    z-index: 1;
    width: 32cqw;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 2cqw;
    box-shadow: 0 2cqw 5cqw rgb(0 0 0 / .14);
  }

  .detail__visual img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .detail__close-icon { display: none; width: 16px; height: 16px; }

  @container (max-width: 700px) {
    .detail__body { width: auto; }
    .detail__visual { display: none; }
    .detail__row { grid-template-columns: 1fr; row-gap: 1cqh; }
    .detail__flow { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; gap: 8px; margin-top: 2.5cqh; }
    .detail__flow > .detail__node { grid-column: auto !important; grid-row: auto !important; }
    .detail__title-rest { display: none; }
    .detail__link { display: none; }
    /* readable sizes on phones: the desktop sizes scale with the screen and get far too small here */
    .detail__close { display: inline-flex; align-items: center; justify-content: center; width: 40px; min-width: 0; height: 40px; padding: 0; border-radius: 50%; }
    .detail__close-text { display: none; }
    .detail__close-icon { display: block; }
    .detail__lead { font-size: 19px; }
    .detail__metrics dt { font-size: 17px; }
    .detail__metrics dd { margin-top: 3px; font-size: 10px; letter-spacing: .06em; }
    .detail__metrics div { padding: 10px 0; }
    .detail__metrics div:nth-child(even) { padding-left: 12px; }
    .detail__node { min-height: 0; padding: 10px; border-radius: 10px; gap: 5px; }
    .detail__node h3 { font-size: 14px; }
    .detail__node ul { gap: 3px; margin-top: 4px; }
    .detail__node li { font-size: 11px; }
    .detail__badge { gap: 4px; padding: 2px 8px; font-size: 9px; }
    .detail__badge svg { width: 10px; }
    .detail__row h3 { font-size: 15px; }
    .detail__row p { font-size: 13px; }
    .detail__chips { gap: 6px; }
    .detail__chips li { padding: 4px 8px; font-size: 10px; border-radius: 5px; }
  }

  @container (max-width: 700px) {
    .case__title { top: 4cqh; left: 6cqw; width: 88cqw; max-width: none; font-size: 6.4cqw; }
    .case__title-rest { display: none; }
    .case__gallery { top: 17cqh; bottom: 3cqh; left: 6cqw; right: 6cqw; grid-template-columns: 1fr; grid-template-rows: 36fr 52fr; row-gap: 2cqh; }
    .case__thumbs { display: none; }
    .case__stage { height: 100%; aspect-ratio: auto; }
    .case__arrow { width: 9cqw; height: 9cqw; }
    .case__card { padding: 4cqw; border-radius: 4cqw; gap: 4cqw; }
    .case__name, .case__label { font-size: 13px; }
    .case__text { font-size: 11px; }
    .case__card .case__tags { gap: 6px; margin-top: 12px; }
    .case__tags li { padding: 4px 8px; font-size: 9px; border-radius: 5px; }
    .case__actions { gap: 8px; margin-top: 16px; }
    .case__button { padding: 10px 16px; font-size: 12px; border-radius: 16px; }
  }

  /* while loading every screen is a flat color block (set in the markup, so it holds from the first paint) */
  .experience.is-loading .screen[data-screen] {
    background: var(--flash-color, var(--color));
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: url('/hero-sky.webp') center / cover;
    pointer-events: none;
    transition: opacity .6s ease;
  }

  .sky--contact { background: none; }
  .experience.is-loading .sky { opacity: 0; }

  /* "scroll down" hint at the very start: a fine-line mouse whose wheel rolls down, with chevrons that follow */
  .scroll-cue {
    position: fixed;
    z-index: 10;
    bottom: 1.4rem;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .55rem;
    width: 2.4rem;
    opacity: 0;
    color: #1c1712;
    transform: translate(-50%, .75rem);
    transition: opacity .7s ease, transform .7s ease; /* the whole hint fades to opacity 0 when scrolling starts */
    pointer-events: none;
  }

  .experience.is-ready:not(.has-entered) .scroll-cue { opacity: 1; transform: translate(-50%, 0); }

  .scroll-cue svg { display: block; width: 100%; height: auto; overflow: visible; }
  .scroll-cue rect, .scroll-cue line, .scroll-cue path { stroke: currentColor; stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }

  .cue__body { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cue__wheel { stroke-width: 1.8; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .cue__chevron { opacity: 0; }


  .experience.is-ready .cue__body { animation: cue-draw 1.3s cubic-bezier(.65, 0, .35, 1) .15s forwards; }
  .experience.is-ready .cue__wheel { animation: cue-wheel 2.4s cubic-bezier(.5, 0, .3, 1) 1.1s infinite; }
  .experience.is-ready .cue__chevron--1 { animation: cue-chevron 2.4s ease-in-out 1.35s infinite; }
  .experience.is-ready .cue__chevron--2 { animation: cue-chevron 2.4s ease-in-out 1.6s infinite; }

  @keyframes cue-draw { to { stroke-dashoffset: 0; } }

  @keyframes cue-wheel {
    0% { opacity: 0; transform: translateY(-2px) scaleY(.6); }
    14% { opacity: 1; transform: translateY(0) scaleY(1); }
    58% { opacity: 1; transform: translateY(15px) scaleY(1); }
    80%, 100% { opacity: 0; transform: translateY(21px) scaleY(.5); }
  }

  @keyframes cue-chevron {
    0%, 12% { opacity: 0; transform: translateY(-3px); }
    40% { opacity: .85; transform: translateY(0); }
    75%, 100% { opacity: 0; transform: translateY(4px); }
  }


  /* phones and touch screens: a finger swiping up instead of the mouse (narrow windows count too, and the script
     adds .is-touch for any device that reports touch points) */
  .scroll-cue .cue__touch { display: none; }
  .cue__hand { opacity: 0; }
  /* an open outline hand drawn with a hairline */
  .scroll-cue .cue__finger { fill: none; stroke-width: .9; }

  @media (hover: none), (pointer: coarse), (max-width: 700px) {
    .scroll-cue .cue__mouse { display: none; }
    .scroll-cue .cue__touch { display: block; }
    .experience.is-ready .cue__hand { animation: cue-swipe 2.2s cubic-bezier(.45, 0, .25, 1) .4s infinite; }
  }

  .experience.is-touch .scroll-cue .cue__mouse { display: none; }
  .experience.is-touch .scroll-cue .cue__touch { display: block; }
  .experience.is-touch.is-ready .cue__hand { animation: cue-swipe 2.2s cubic-bezier(.45, 0, .25, 1) .4s infinite; }


  @keyframes cue-swipe {
    0% { opacity: 0; transform: translateY(10px); }
    18% { opacity: 1; transform: translateY(10px); }
    62% { opacity: 1; transform: translateY(-12px); }
    82%, 100% { opacity: 0; transform: translateY(-14px); }
  }


  @media (prefers-reduced-motion: reduce) {
    .experience.is-ready .cue__hand,
    .experience.is-touch.is-ready .cue__hand { animation: none; }
    .cue__hand { opacity: 1; }
    .experience.is-ready .cue__body,
    .experience.is-ready .cue__wheel,
    .experience.is-ready .cue__chevron,
    .cue__body { stroke-dashoffset: 0; }
    .cue__wheel { opacity: 1; }
    .cue__chevron { opacity: .6; }
  }
</style>
