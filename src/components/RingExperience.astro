  .works__name svg { flex: none; width: max(10px, 1cqw); height: auto; transition: transform .4s cubic-bezier(.22, 1, .36, 1); }
  .works__card:hover .works__name svg { transform: translate(.15cqw, -.15cqw); }

  .works__all {
