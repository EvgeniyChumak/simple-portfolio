    .works__all { padding: 6px 12px; }
    .more__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); margin-top: 3cqh; }
  }

  .contact__top {
