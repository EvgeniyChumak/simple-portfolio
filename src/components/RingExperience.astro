    font-size: max(10px, min(.85cqw, 1.6cqh));
    font-weight: 500;
    color: rgb(var(--ink-rgb) / 1);
    cursor: pointer;
    transition: background-color .3s ease, color .3s ease;
  }

  .works__all:hover, .works__all:focus-visible { background: rgb(var(--ink-rgb) / 1); color: #f4faff; outline: none; }

  /* "See all projects" sections: six screenshots in a 3 x 2 grid, the NDA note closes the last one */
  .more__grid {
