    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / .6);
  }

  .works__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.4cqh 1.2cqw; }

  .works__card { display: flex; flex-direction: column; gap: 1.2cqh; min-width: 0; min-height: 0; color: rgb(var(--ink-rgb) / 1); text-decoration: none; }

  /* screenshots keep their own 1530 x 900 shape */
  .works__shot { display: block; aspect-ratio: 17 / 10; overflow: hidden; border-radius: .7cqw; background: rgba(255, 255, 255, .45); }

  .works__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform .8s cubic-bezier(.22, 1, .36, 1);
